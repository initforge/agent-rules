{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "actor": "allow",
    "external_directory": "allow",
    "skill": "allow"
  },
  "skills": {
    "paths": [
      "P:/agent-rules/skills/",
      "P:/agent-rules/rules/"
    ]
  }
}
