{
  "$schema": "../schemas/skill-fabric-candidate.schema.json",
  "version": 1,
  "description": "AM-010 candidate fabric. These are explicit planning candidates, not installed skills and not active runtime routes.",
  "candidates": [
    {
      "id": "frontend-design-contract",
      "domain": "frontend",
      "owner": "harness-maintainer",
      "status": "candidate",
      "phases": ["discussion", "plan", "implementation", "verification", "review"],
      "trigger": { "facts": ["frontend stack facts", "project design contract", "explicit design brief"], "never_from_keywords_alone": true },
      "conflicts": ["frontend-architect", "ui-taste", "global visual defaults"],
      "inputs": ["project design contract", "TaskPacket claim/risk", "asset/provider availability"],
      "outputs": ["create/implement/review direction", "design evidence contract", "runtime acceptance requirements"],
      "required_capabilities": ["design.inspect", "browser.verify", "filesystem.read"],
      "evaluation": ["brief-led activation precision", "implementation/review separation", "browser acceptance remains independent"],
      "activation_gate": ["owner-approved schema", "consumer map", "Pencil explicit-only compatibility fixture", "headed browser eval"],
      "removal_path": "Retire frontend-architect/ui-taste compatibility overlap only after design-contract and browser parity evidence."
    },
    {
      "id": "mobile-composition",
      "domain": "mobile",
      "owner": "harness-maintainer",
      "status": "candidate",
      "phases": ["plan", "implementation", "verification", "review"],
      "trigger": { "facts": ["Expo or React Native RepoFacts", "native platform capability matrix"], "never_from_keywords_alone": true },
      "conflicts": ["web-only browser assumptions", "inferred device proof"],
      "inputs": ["mobile stack facts", "simulator/device availability", "release target"],
      "outputs": ["composable mobile tasks", "device/e2e proof plan", "human residual packet"],
      "required_capabilities": ["filesystem.read", "browser.verify", "mobile.device"],
      "evaluation": ["Expo/RN detection precision", "simulator/device proof separation", "flaky-provider recovery"],
      "activation_gate": ["host/device matrix", "E2E provider contract", "fresh real-device or explicit unavailable receipts"],
      "removal_path": "Remove only after native/mobile capabilities are owned by a verified domain adapter with parity and rollback."
    },
    {
      "id": "backend-composition",
      "domain": "backend",
      "owner": "harness-maintainer",
      "status": "candidate",
      "phases": ["plan", "implementation", "verification", "review"],
      "trigger": { "facts": ["backend framework facts", "API/auth/concurrency claim types"], "never_from_keywords_alone": true },
      "conflicts": ["default mega-backend skill", "framework-agnostic guessed conventions"],
      "inputs": ["framework/version facts", "auth boundary", "transaction/concurrency claims"],
      "outputs": ["composable API/auth/integration procedures", "claim-specific verifier plan"],
      "required_capabilities": ["code.search", "code.semantic", "filesystem.write"],
      "evaluation": ["minimal active surface", "auth-boundary safety", "integration and concurrency proof sufficiency"],
      "activation_gate": ["framework detector fixtures", "composability contract", "security and integration evals"],
      "removal_path": "Keep only the smallest composable procedures; delete any facade that duplicates verifier or rule authority."
    },
    {
      "id": "database-stack",
      "domain": "database",
      "owner": "harness-maintainer",
      "status": "candidate",
      "phases": ["plan", "implementation", "verification", "review"],
      "trigger": { "facts": ["database schema/tool RepoFacts", "database claim type"], "never_from_keywords_alone": true },
      "conflicts": ["migration procedure bundled into query knowledge", "blind upstream guidance"],
      "inputs": ["schema/tool facts", "query/data invariants", "credentials/effect policy"],
      "outputs": ["stack-specific query guidance", "disposable DB verification plan"],
      "required_capabilities": ["code.search", "filesystem.read", "database.disposable"],
      "evaluation": ["Postgres/Prisma/Drizzle detection", "query invariant coverage", "credential isolation"],
      "activation_gate": ["pinned guidance source", "schema fixture", "real/disposable DB receipt"],
      "removal_path": "Retire stack-specific facade when provider-neutral database claims and verifiers cover the same outcomes."
    },
    {
      "id": "schema-migration",
      "domain": "database-migration",
      "owner": "harness-maintainer",
      "status": "candidate",
      "phases": ["plan", "implementation", "verification", "review"],
      "trigger": { "facts": ["migration files", "database stack facts", "explicit schema-change claim"], "never_from_keywords_alone": true },
      "conflicts": ["production migration without owner authority", "query-only proof"],
      "inputs": ["before/after schema", "upgrade/rollback policy", "disposable real DB"],
      "outputs": ["migration packet", "invariant and rollback evidence", "authority blocker if needed"],
      "required_capabilities": ["database.disposable", "filesystem.write", "owner.approval"],
      "evaluation": ["upgrade/downgrade reproducibility", "data invariant preservation", "destructive boundary enforcement"],
      "activation_gate": ["migration schema", "real disposable DB fixture", "owner authority contract"],
      "removal_path": "Never remove the separate migration boundary; consolidate only its implementation adapters after parity."
    },
    {
      "id": "infra-devops-composition",
      "domain": "infra-devops",
      "owner": "harness-maintainer",
      "status": "candidate",
      "phases": ["plan", "implementation", "verification", "review"],
      "trigger": { "facts": ["Terraform/Kubernetes/container facts", "environment/effect policy"], "never_from_keywords_alone": true },
      "conflicts": ["apply/destroy inferred from availability", "production effects without owner approval"],
      "inputs": ["infra facts", "desired plan", "effect/approval contract"],
      "outputs": ["inspect/diagnose/plan/verify packet", "approval-gated apply/destroy task"],
      "required_capabilities": ["filesystem.read", "shell.exec", "owner.approval"],
      "evaluation": ["plan-before-apply", "destructive effect rejection", "provider-neutral fallback"],
      "activation_gate": ["effect schema", "dry-run fixtures", "production boundary and rollback evidence"],
      "removal_path": "Keep inspect/plan separate from apply/destroy; remove only redundant provider wrappers after receipt parity."
    },
    {
      "id": "security-review",
      "domain": "security",
      "owner": "harness-maintainer",
      "status": "candidate",
      "phases": ["discussion", "plan", "verification", "review"],
      "trigger": { "facts": ["security claim/risk", "auth/data/effect surface"], "never_from_keywords_alone": true },
      "conflicts": ["security prose replacing deterministic verifier", "worker-authored security PASS"],
      "inputs": ["threat model", "changed scope", "security verifier availability"],
      "outputs": ["threat model", "deterministic security checks", "independent review packet"],
      "required_capabilities": ["code.search", "filesystem.read", "security.scan"],
      "evaluation": ["seeded vulnerability detection", "false-green rejection", "independent review separation"],
      "activation_gate": ["risk routing contract", "seeded fixtures", "security provider trust/effect review"],
      "removal_path": "Retire only duplicate prose; retain independent security review and deterministic proof ownership."
    },
    {
      "id": "claim-test-strategy",
      "domain": "testing",
      "owner": "harness-maintainer",
      "status": "candidate",
      "phases": ["plan", "verification", "review"],
      "trigger": { "facts": ["claim type", "risk", "available verifier capabilities"], "never_from_keywords_alone": true },
      "conflicts": ["framework-specific default testing skill", "test-count-as-proof"],
      "inputs": ["claims", "minimum proof level", "provider matrix", "failure history"],
      "outputs": ["cheapest-sufficient evidence plan", "escalation and fallback", "human residual"],
      "required_capabilities": ["filesystem.read", "browser.verify", "code.search"],
      "evaluation": ["verified success", "time/tokens/cost", "retries and human minutes", "unnecessary activation"],
      "activation_gate": ["claim/verifier schema", "cross-domain corpus", "ablation showing trust gain"],
      "removal_path": "Promote policy into verifier selection and remove only generic testing prose with behavioral parity."
    },
    {
      "id": "external-skill-governance",
      "domain": "governance",
      "owner": "harness-maintainer",
      "status": "candidate",
      "phases": ["discussion", "plan", "review"],
      "trigger": { "facts": ["external source reference", "skill/provider addition request"], "never_from_keywords_alone": true },
      "conflicts": ["blind upstream installation", "unreviewed content in core"],
      "inputs": ["source repo/path/commit", "license", "content hash", "compatibility/eval delta"],
      "outputs": ["trust receipt", "freshness/deprecation state", "rollback and consumer impact"],
      "required_capabilities": ["web", "filesystem.read", "owner.approval"],
      "evaluation": ["source integrity", "security/content review", "marginal trust gain versus cost"],
      "activation_gate": ["pinned source", "license/security review", "local eval and rollback record"],
      "removal_path": "Garbage-collect candidate content with stale source, no consumer, or negative marginal trust gain."
    }
  ]
}
