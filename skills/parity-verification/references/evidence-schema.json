{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/parity-evidence.schema.json",
  "title": "Parity Evidence",
  "description": "Evidence artifact for a single parity verification claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "dimension",
    "state",
    "viewport",
    "verdict",
    "captured_at",
    "environment",
    "evidence_artifacts"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "description": "Reference to the claim ID"
    },
    "dimension": {
      "enum": ["visual", "responsive", "behavioral", "accessibility", "console", "network", "data-state"],
      "description": "Parity dimension being verified"
    },
    "state": {
      "enum": ["loading", "populated", "empty", "error", "hover", "focus", "keyboard", "touch"],
      "description": "Application state at capture time"
    },
    "viewport": {
      "type": "string",
      "description": "Viewport label (desktop or mobile)"
    },
    "viewport_width": {
      "type": "integer",
      "description": "Viewport width in pixels"
    },
    "viewport_height": {
      "type": "integer",
      "description": "Viewport height in pixels"
    },
    "verdict": {
      "enum": ["PASS", "FAIL", "UNVERIFIED", "FLAKY", "BLOCKED"],
      "description": "Verdict for this claim"
    },
    "expected": {
      "type": "string",
      "description": "Expected outcome description"
    },
    "observed": {
      "type": "string",
      "description": "What was actually observed"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of evidence capture"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "locale", "timezone", "dpr"],
      "properties": {
        "browser": {
          "type": "string",
          "description": "Browser name and version"
        },
        "locale": {
          "type": "string",
          "description": "Locale string"
        },
        "timezone": {
          "type": "string",
          "description": "Timezone string"
        },
        "dpr": {
          "type": "number",
          "description": "Device pixel ratio"
        },
        "font_hint": {
          "type": "string",
          "description": "Expected font stack at capture time"
        },
        "data_fixture": {
          "type": "string",
          "description": "Data fixture identifier used"
        }
      }
    },
    "evidence_artifacts": {
      "type": "array",
      "description": "List of evidence files produced",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 1
    },
    "residual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": ["defect", "accepted_deviation", "environment_rendering", "unknown"],
          "description": "Classification of the residual difference"
        },
        "details": {
          "type": "string",
          "description": "Explanation of the residual difference"
        },
        "expected_value": {
          "type": "string",
          "description": "Expected value that differed"
        },
        "actual_value": {
          "type": "string",
          "description": "Actual value observed"
        }
      },
      "required": ["classification"]
    },
    "visual_diff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "diff_score": {
          "type": "number",
          "description": "Pixel diff percentage (0-100)"
        },
        "diff_path": {
          "type": "string",
          "description": "Path to visual diff image"
        },
        "baseline_path": {
          "type": "string",
          "description": "Path to expected baseline image"
        },
        "actual_path": {
          "type": "string",
          "description": "Path to actual captured image"
        },
        "flaky_detected": {
          "type": "boolean",
          "description": "Whether this visual check appeared flaky"
        },
        "flaky_reason": {
          "type": "string",
          "description": "Reason for flaky classification"
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "message": { "type": "string" },
              "source": { "type": "string" },
              "level": { "enum": ["error", "warning", "info"] },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "required": ["message", "level"]
          }
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failed_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string" },
              "method": { "type": "string" },
              "status": { "type": "integer" },
              "status_text": { "type": "string" },
              "duration_ms": { "type": "number" }
            },
            "required": ["url", "method", "status"]
          }
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "impact": { "type": "string" },
              "description": { "type": "string" },
              "nodes": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["id", "impact", "description"]
          }
        },
        "violation_count": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot_path": {
          "type": "string",
          "description": "Path to a11y tree snapshot JSON"
        }
      }
    },
    "verifier": {
      "type": "string",
      "description": "Tool or agent that performed verification"
    },
    "flaky_run_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Run IDs from previous flaky attempts for this claim"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {
          "enum": ["screenshot", "a11y_snapshot", "console_log", "network_log", "visual_diff", "source_assertion", "performance_trace"],
          "description": "Type of evidence artifact"
        },
        "path": {
          "type": "string",
          "description": "Relative path to the artifact file"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hash of the artifact"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "File size in bytes"
        },
        "modified_at": {
          "type": "string",
          "format": "date-time",
          "description": "File modification timestamp"
        },
        "label": {
          "type": "string",
          "description": "Human-readable label for this artifact"
        }
      }
    }
  }
}
