{
  "version": 2,
  "registry": {
    "host_ids": [
      "codex",
      "claude",
      "grok",
      "opencode",
      "antigravity",
      "cursor",
      "deepseek-harness",
      "command-code"
    ],
    "certification_policy": {
      "certification_required_hosts": [
        "codex",
        "claude",
        "opencode",
        "cursor",
        "antigravity",
        "grok",
        "deepseek-harness",
        "command-code"
      ],
      "deferred_supported_targets": [],
      "not_live_verified_targets": []
    },
    "capability_to_canary": {
      "instruction_surface": "instruction_delivery_canary",
      "context_injection": "context_injection_canary",
      "skill_surface": "skill_selection_canary",
      "hook_surface": "hook_invocation_canary",
      "permission_surface": "permission_deny_canary",
      "sandbox_surface": "sandbox_mutation_canary",
      "subagent_surface": "subagent_spawn_canary",
      "session_surface": "session_lifecycle_canary",
      "worktree_surface": "worktree_isolate_canary",
      "mcp_surface": "mcp_lease_canary",
      "headless_surface": "headless_session_canary",
      "compaction_surface": "compaction_canary",
      "structured_event_surface": "event_emission_canary",
      "planning_surface": "plan_mode_canary",
      "model_observability": "model_observability_canary"
    }
  },
  "parity_contract": {
    "required_live_invariants": [
      "activation",
      "context_delivery",
      "orchestration",
      "role_permissions",
      "model_effort",
      "mcp_integration"
    ],
    "static_artifacts_are_sufficient": false,
    "aggregate_rule": "all_platforms_require_current_live_evidence",
    "certification_required_hosts": [
      "codex",
      "claude",
      "opencode",
      "cursor",
      "antigravity",
      "grok",
      "deepseek-harness",
      "command-code"
    ],
    "deferred_supported_targets": []
  },
  "platforms": {
    "codex": {
      "runtime": {
        "home_env": "CODEX_HOME",
        "home_default": "~/.codex",
        "global_entrypoint": "$CODEX_HOME/AGENTS.md"
      },
      "bootstrap": {
        "strategy": "managed_file",
        "entrypoint": "AGENTS.md",
        "restart_action": "start_new_task"
      },
      "routing": {
        "hook_lifecycle": "UserPromptSubmit",
        "context_delivery": "route_capsule_injection"
      },
      "orchestration": {
        "native_spawn_tool": "spawn_agent",
        "agent_discovery": "$CODEX_HOME/agents",
        "model_attestation": "host_attested",
        "permission_capability": "sandbox_enforced",
        "isolation_capability": "worktree_or_shared",
        "agent_materialization": "managed_directory"
      },
      "mcp": {
        "config_path": "$CODEX_HOME/config.toml",
        "format": "toml_mcp_servers",
        "native_inspect": "codex mcp list",
        "live_doctor": "native_mcp_ping"
      }
    },
    "claude": {
      "runtime": {
        "home_env": "CLAUDE_CONFIG_DIR",
        "home_default": "~/.claude",
        "global_entrypoint": "$CLAUDE_CONFIG_DIR/CLAUDE.md"
      },
      "bootstrap": {
        "strategy": "managed_file",
        "entrypoint": "CLAUDE.md",
        "restart_action": "start_new_session"
      },
      "routing": {
        "hook_lifecycle": "UserPromptSubmit",
        "context_delivery": "hook_additional_context"
      },
      "orchestration": {
        "native_spawn_tool": "Agent",
        "agent_discovery": "$CLAUDE_CONFIG_DIR/agents",
        "model_attestation": "host_attested",
        "permission_capability": "host_enforced",
        "isolation_capability": "worktree_or_shared",
        "agent_materialization": "managed_directory"
      },
      "mcp": {
        "config_path": "~/.claude.json",
        "format": "json_mcpServers",
        "native_inspect": "claude mcp list",
        "live_doctor": "native_mcp_ping"
      }
    },
    "grok": {
      "runtime": {
        "home_env": "GROK_HOME",
        "home_default": "~/.grok",
        "global_entrypoint": "$GROK_HOME/.grok/rules"
      },
      "bootstrap": {
        "strategy": "managed_directory",
        "entrypoint": ".grok/rules",
        "restart_action": "restart_or_reload"
      },
      "routing": {
        "hook_lifecycle": "host_native_prompt_hook",
        "context_delivery": "route_capsule_injection"
      },
      "orchestration": {
        "native_spawn_tool": "native_subagent",
        "agent_discovery": "$GROK_HOME/agents",
        "model_attestation": "host_attested",
        "permission_capability": "host_declared",
        "isolation_capability": "host_declared",
        "agent_materialization": "managed_directory"
      },
      "mcp": {
        "config_path": "$GROK_HOME/mcp.json",
        "format": "json_mcpServers",
        "native_inspect": "grok mcp list",
        "live_doctor": "native_mcp_ping"
      }
    },
    "antigravity": {
      "runtime": {
        "home_env": "ANTIGRAVITY_HOME",
        "home_default": "~/.gemini/config",
        "global_entrypoint": "~/.gemini/GEMINI.md"
      },
      "bootstrap": {
        "strategy": "managed_marked_block",
        "entrypoint": "GEMINI.md",
        "restart_action": "restart_or_reload"
      },
      "routing": {
        "hook_lifecycle": "PreInvocation",
        "context_delivery": "injectSteps.ephemeralMessage"
      },
      "orchestration": {
        "native_spawn_tool": "invoke_subagent",
        "agent_discovery": "$ANTIGRAVITY_HOME/agents",
        "model_attestation": "host_attested",
        "permission_capability": "host_declared",
        "isolation_capability": "workspace_mode",
        "agent_materialization": "managed_directory"
      },
      "mcp": {
        "config_path": "$ANTIGRAVITY_HOME/mcp_config.json",
        "format": "json_mcpServers",
        "native_inspect": "antigravity_mcp_ui",
        "live_doctor": "native_mcp_ping"
      }
    },
    "cursor": {
      "runtime": {
        "home_env": "CURSOR_HOME",
        "home_default": "~/.cursor",
        "global_entrypoint": "$CURSOR_HOME/rules"
      },
      "bootstrap": {
        "strategy": "local_plugin",
        "entrypoint": "rules",
        "restart_action": "reload_window"
      },
      "routing": {
        "hook_lifecycle": "beforeSubmitPrompt",
        "context_delivery": "local_plugin_route_capsule"
      },
      "orchestration": {
        "native_spawn_tool": "Task",
        "agent_discovery": "$CURSOR_HOME/agents",
        "model_attestation": "deferred_host_attestation",
        "permission_capability": "host_declared",
        "isolation_capability": "host_declared",
        "agent_materialization": "managed_directory"
      },
      "mcp": {
        "config_path": "$CURSOR_HOME/mcp.json",
        "format": "json_mcpServers",
        "native_inspect": "cursor_mcp_ui",
        "live_doctor": "native_mcp_ping"
      }
    },
    "opencode": {
      "runtime": {
        "home_env": "OPENCODE_HOME",
        "home_default": "~/.config/opencode",
        "global_entrypoint": "AGENTS.md"
      },
      "bootstrap": {
        "strategy": "managed_directory",
        "entrypoint": "AGENTS.md",
        "restart_action": "restart_or_reload"
      },
      "routing": {
        "hook_lifecycle": "none",
        "context_delivery": "route_capsule_injection"
      },
      "orchestration": {
        "native_spawn_tool": "none",
        "agent_discovery": "$OPENCODE_HOME/agents",
        "model_attestation": "host_declared",
        "permission_capability": "role_prompt",
        "isolation_capability": "host_declared",
        "agent_materialization": "managed_directory"
      },
      "mcp": {
        "config_path": "$OPENCODE_HOME/opencode.json",
        "format": "json_mcpServers",
        "native_inspect": "opencode_mcp_ui",
        "live_doctor": "native_mcp_ping"
      }
    },
    "deepseek-harness": {
      "runtime": {
        "home_env": "DSH_HOME",
        "home_default": "~/.config/deepseek-harness",
        "global_entrypoint": "managed profile/bundle via dsh plugin"
      },
      "bootstrap": {
        "strategy": "managed_bundle_profile",
        "entrypoint": "dsh plugin --profile add",
        "restart_action": "supervised_launch"
      },
      "routing": {
        "hook_lifecycle": "agent.inject_pre_execute_waterfall",
        "context_delivery": "system_prompt_seam"
      },
      "orchestration": {
        "native_spawn_tool": "dsh_native_subagent",
        "agent_discovery": "managed_profile_bundle",
        "model_attestation": "host_attested",
        "permission_capability": "native_approval_tool_guard",
        "isolation_capability": "native_sandbox",
        "agent_materialization": "host_native"
      },
      "mcp": {
        "config_path": "$DSH_HOME/mcp.json",
        "format": "json_mcpServers",
        "native_inspect": "dsh --dump-config",
        "live_doctor": "bundle_hash_and_config_fingerprint"
      }
    },
    "command-code": {
      "runtime": {
        "home_env": "COMMAND_CODE_HOME",
        "home_default": "~/.command-code",
        "global_entrypoint": "session-scoped --mod"
      },
      "bootstrap": {
        "strategy": "managed_session_mod",
        "entrypoint": "--mod agent-rules",
        "restart_action": "supervised_session_launch"
      },
      "routing": {
        "hook_lifecycle": "beforeToolCall_preToolUse",
        "context_delivery": "appendSystemPrompt_transformContext"
      },
      "orchestration": {
        "native_spawn_tool": "built_in_isolated_agent",
        "agent_discovery": "namespaced_custom_agents_on_demand",
        "model_attestation": "host_attested",
        "permission_capability": "native_permission_rules_modes",
        "isolation_capability": "native_permission_layer",
        "agent_materialization": "host_native"
      },
      "mcp": {
        "config_path": "$COMMAND_CODE_HOME/mcp.json",
        "format": "json_mcpServers",
        "native_inspect": "command-code mcp list",
        "live_doctor": "native_permission_fingerprint"
      }
    }
  }
}