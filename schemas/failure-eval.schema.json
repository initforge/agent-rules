{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/failure-eval.schema.json",
  "title": "Failure-to-Eval Candidate",
  "description": "Repeated classified failures converted into reviewed eval candidates with promotion review, historical replay, and model/provider workaround retirement (AM-0001, REQ-019).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "candidate_id", "failure_class", "occurrences", "promotion_status", "created_at"],
  "properties": {
    "schema": { "const": "harness/failure-eval-candidate" },
    "version": { "const": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "failure_class": { "type": "string", "minLength": 1 },
    "occurrences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observed_at", "work_id", "claim_id", "failure"],
        "properties": {
          "observed_at": { "type": "string", "format": "date-time" },
          "work_id": { "type": "string", "minLength": 1 },
          "claim_id": { "type": "string", "minLength": 1 },
          "failure": { "type": "string", "minLength": 1 },
          "evidence_ref": { "type": "string" }
        }
      }
    },
    "promotion_status": { "enum": ["draft", "review-required", "reviewed", "accepted", "promoted", "rejected"] },
    "promotion_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_by", "reviewed_at", "verdict"],
      "properties": {
        "reviewed_by": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "verdict": { "enum": ["promote", "reject", "needs-work"] },
        "replay_required": { "type": "boolean" },
        "replay_refs": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "workaround": {
      "description": "Model/provider-specific workaround evidence: owner, trigger, bounded scope, revalidation, expiry, retirement.",
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "trigger", "scope", "revalidation_required", "expires_at", "retirement_evidence"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "revalidation_required": { "type": "boolean" },
        "revalidation_evidence": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date-time" },
        "retirement_evidence": { "type": "string", "minLength": 1 },
        "retired_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
