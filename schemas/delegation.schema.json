{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/delegation.schema.json",
  "title": "Portable Delegation Receipt",
  "description": "A task delegation receipt that records what was assigned, to whom, what context was supplied, what files were owned and changed, tool activity, result, evidence, status, and integration verdict. Platform-neutral; serves as an audit trail for sub-agent work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "task_id", "objective", "role", "status"
  ],
  "properties": {
    "schema": { "const": "artifact/delegation" },
    "version": { "const": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "requirement_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "role": { "type": "string", "minLength": 1 },
    "model": { "type": "string" },
    "effort": {
      "type": "string",
      "enum": ["low", "medium", "high", "unset"]
    },
    "supplied_context": {
      "type": "array",
      "items": { "type": "string" }
    },
    "owned_files": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "forbidden_files": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "actual_files_changed": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "tool_activity_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_tool_calls": { "type": "integer", "minimum": 0 },
        "tool_classes_used": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["read", "edit", "test", "shell", "browser", "network", "git", "external-write"]
          }
        }
      }
    },
    "result": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "status"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string" },
          "artifact": { "type": "string" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "blocked", "failed", "cancelled"]
    },
    "integration_verdict": {
      "type": "string",
      "enum": ["clean", "conflicts", "needs_review", "rejected", "unverified"]
    }
  }
}
