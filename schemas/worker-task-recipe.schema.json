{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/worker-task-recipe.schema.json",
  "title": "Self-contained Worker Task Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "planId", "planRevision", "taskId", "goal", "requirementIds", "claimIds", "dependencies", "ownedPaths", "forbiddenPaths", "sourceAnchors", "decisions", "context", "microsteps", "invariants", "edgeCases", "proof", "rollback", "failurePlaybook", "stopIf", "budgets", "modelTier", "riskTier", "recipeSha256"],
  "properties": {
    "schema": { "const": "harness/worker-task-recipe" },
    "version": { "const": 1 },
    "planId": { "type": "string", "minLength": 1 },
    "planRevision": { "type": "integer", "minimum": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "claimIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "ownedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "forbiddenPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sourceAnchors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "section", "lineStart", "lineEnd", "contentSha256", "requirementId"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "section": { "type": "string", "minLength": 1 },
          "lineStart": { "type": "integer", "minimum": 1 },
          "lineEnd": { "type": "integer", "minimum": 1 },
          "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "requirementId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "decisions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "context": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "microsteps": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "edgeCases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "proof": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claimId", "verifierId", "command"],
        "properties": {
          "claimId": { "type": "string", "minLength": 1 },
          "verifierId": { "type": "string", "minLength": 1 },
          "command": {
            "type": "object", "additionalProperties": false, "required": ["executable", "args"],
            "properties": {
              "executable": { "type": "string", "minLength": 1 },
              "args": { "type": "array", "items": { "type": "string" } },
              "cwd": { "type": "string", "minLength": 1 },
              "timeoutMs": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "rollback": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "failurePlaybook": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "stopIf": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "budgets": {
      "type": "object", "additionalProperties": false, "required": ["token", "decisionSurface"],
      "properties": { "token": { "type": "integer", "minimum": 1, "maximum": 12000 }, "decisionSurface": { "type": "integer", "minimum": 1, "maximum": 32 } }
    },
    "modelTier": { "enum": ["economy", "standard", "expert"] },
    "riskTier": { "enum": ["low", "medium", "high", "critical"] },
    "recipeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
