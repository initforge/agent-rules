{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/change-facts.schema.json",
  "title": "Derived ChangeFacts projection",
  "description": "A recomputable view of the actual work impact. It is not an independent source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["modules", "symbols", "kinds", "impact", "effects", "design_baseline_changed", "source"],
  "properties": {
    "modules": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "symbols": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "kinds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "impact": {
      "type": "object", "additionalProperties": false,
      "required": ["dependency_breadth", "public_api", "schema", "security_boundary", "destructive"],
      "properties": {
        "dependency_breadth": { "type": "string", "minLength": 1 },
        "public_api": { "type": "boolean" },
        "schema": { "type": "boolean" },
        "security_boundary": { "type": "boolean" },
        "destructive": { "type": "boolean" }
      }
    },
    "effects": {
      "type": "object", "additionalProperties": false,
      "required": ["repo_write", "external_write"],
      "properties": { "repo_write": { "type": "boolean" }, "external_write": { "type": "boolean" } }
    },
    "design_baseline_changed": { "type": "boolean" },
    "source": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
