{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-rules.local/schemas/verification-profile.schema.json",
  "title": "Verification Profile",
  "description": "DoD §37 / SS-13 / R-025 verification contract for a harness task. The profile is the bridge between the runner's historical `verification: string[]` and the richer evidence surface (Playwright / browser-script / mcp-tool-call / visual-diff) required by browser-based verification. Provider step kinds (testcontainers, pact, schemathesis, storybook, maestro, semgrep, codeql, k6, opentelemetry) are claim-driven lifecycle adapters: activation is never global, a missing optional provider yields explicit UNAVAILABLE evidence (never PASS), k6 requires explicit thresholds, and telemetry evidence never substitutes product acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "steps",
    "evidence"
  ],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/ShellStep"
          },
          {
            "$ref": "#/$defs/PlaywrightStep"
          },
          {
            "$ref": "#/$defs/BrowserScriptStep"
          },
          {
            "$ref": "#/$defs/McpToolCallStep"
          },
          {
            "$ref": "#/$defs/VisualDiffStep"
          },
          {
            "$ref": "#/$defs/TestcontainersStep"
          },
          {
            "$ref": "#/$defs/PactStep"
          },
          {
            "$ref": "#/$defs/SchemathesisStep"
          },
          {
            "$ref": "#/$defs/StorybookStep"
          },
          {
            "$ref": "#/$defs/MaestroStep"
          },
          {
            "$ref": "#/$defs/SemgrepStep"
          },
          {
            "$ref": "#/$defs/CodeqlStep"
          },
          {
            "$ref": "#/$defs/K6Step"
          },
          {
            "$ref": "#/$defs/OpenTelemetryStep"
          }
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "screenshot",
          "console",
          "network",
          "a11y",
          "mcp-response",
          "container-log",
          "contract-verification",
          "schema-report",
          "story-state",
          "device-run",
          "scan-report",
          "threshold-report",
          "telemetry-trace",
          "unavailable-evidence"
        ]
      },
      "default": []
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "description": "Hard ceiling on the whole profile. Defaults to 10 minutes per step when unset."
    },
    "failFast": {
      "type": "boolean",
      "default": false,
      "description": "When true, stop evaluation after the first failing ordered step. North-Star uses this after cheap-to-deep graph ordering; legacy profiles default false."
    },
    "activation": {
      "type": "string",
      "enum": ["claim-driven", "explicit", "automatic"],
      "description": "Provider activation mode. Provider adapters are claim-driven: they activate only when an actual claim needs them, never globally."
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "description": "Provider adapter id (matches integrations/providers/<id>/manifest.json)."
    },
    "unavailable_status": {
      "type": "string",
      "enum": ["UNAVAILABLE", "BLOCKED"],
      "description": "Fail-closed status when the provider/runtime is unavailable. Never PASS."
    },
    "thresholds_required": {
      "type": "boolean",
      "description": "When true, the profile activates only against explicit thresholds/SLO claims (k6)."
    },
    "telemetry_only": {
      "type": "boolean",
      "description": "When true, evidence from this profile can never substitute product acceptance."
    }
  },
  "$defs": {
    "ShellStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "command"
      ],
      "properties": {
        "kind": {
          "const": "shell"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Exit-0 command. The historical runner contract."
        }
      }
    },
    "PlaywrightStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "spec"
      ],
      "properties": {
        "kind": {
          "const": "playwright"
        },
        "spec": {
          "type": "string",
          "minLength": 1,
          "description": "Path or label for the Playwright spec; the harness writes a tiny driver that launches Chromium with a per-task browser-profile directory (tab/profile isolation)."
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL the harness navigates to before screenshotting."
        },
        "headed": {
          "type": "boolean",
          "default": false,
          "description": "Open Chromium visibly so the operator can watch the verification."
        },
        "tabProfile": {
          "type": "string",
          "description": "Per-task browser-profile directory name; defaults to a per-task isolated profile under `.agent/runs/<run-id>/browser-profiles/`."
        }
      }
    },
    "BrowserScriptStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "browser-script"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path to a Node script that drives a real browser through MCP. The script writes evidence to <evidenceDir>/."
        },
        "headed": {
          "type": "boolean",
          "default": false
        },
        "tabProfile": {
          "type": "string"
        }
      }
    },
    "McpToolCallStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "server",
        "tool"
      ],
      "properties": {
        "kind": {
          "const": "mcp-tool-call"
        },
        "server": {
          "type": "string",
          "minLength": 1,
          "description": "MCP server id (matches an entry in integrations/registry.json)."
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "description": "Arbitrary JSON the harness forwards to the tool as the call arguments."
        }
      }
    },
    "VisualDiffStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "baseline",
        "current"
      ],
      "properties": {
        "kind": {
          "const": "visual-diff"
        },
        "baseline": {
          "type": "string",
          "minLength": 1,
          "description": "Reference image path."
        },
        "current": {
          "type": "string",
          "minLength": 1,
          "description": "Image path to compare against baseline."
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.01,
          "description": "Allowed pixel-difference ratio."
        }
      }
    },
    "TestcontainersStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "spec"
      ],
      "properties": {
        "kind": {
          "const": "testcontainers"
        },
        "spec": {
          "type": "string",
          "minLength": 1,
          "description": "Testcontainers spec/test file that starts disposable real dependencies."
        }
      }
    },
    "PactStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "spec"
      ],
      "properties": {
        "kind": {
          "const": "pact"
        },
        "spec": {
          "type": "string",
          "minLength": 1,
          "description": "Pact contract file or consumer/provider verification target."
        }
      }
    },
    "SchemathesisStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "spec"
      ],
      "properties": {
        "kind": {
          "const": "schemathesis"
        },
        "spec": {
          "type": "string",
          "minLength": 1,
          "description": "OpenAPI/GraphQL schema path or URL."
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "Disposable test API base URL the schema behavior runner targets."
        }
      }
    },
    "StorybookStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "stories"
      ],
      "properties": {
        "kind": {
          "const": "storybook"
        },
        "stories": {
          "type": "string",
          "minLength": 1,
          "description": "Story glob/location for the component states to verify."
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "Running Storybook server URL; defaults to a harness-started instance."
        }
      }
    },
    "MaestroStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "flow"
      ],
      "properties": {
        "kind": {
          "const": "maestro"
        },
        "flow": {
          "type": "string",
          "minLength": 1,
          "description": "Maestro flow YAML for the device interaction."
        },
        "device": {
          "type": "string",
          "description": "Target device/emulator id; defaults to the connected device."
        }
      }
    },
    "SemgrepStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target"
      ],
      "properties": {
        "kind": {
          "const": "semgrep"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "Local path scanned for security patterns."
        }
      }
    },
    "CodeqlStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "language"
      ],
      "properties": {
        "kind": {
          "const": "codeql"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "description": "Language under analysis; CodeQL runs in CI only."
        }
      }
    },
    "K6Step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "script",
        "thresholds"
      ],
      "properties": {
        "kind": {
          "const": "k6"
        },
        "script": {
          "type": "string",
          "minLength": 1,
          "description": "k6 load script path."
        },
        "thresholds": {
          "type": "object",
          "minProperties": 1,
          "description": "Explicit thresholds/SLO (e.g. p95 latency ms, error rate %). Performance checks require explicit thresholds."
        }
      }
    },
    "OpenTelemetryStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "collector"
      ],
      "properties": {
        "kind": {
          "const": "opentelemetry"
        },
        "collector": {
          "type": "string",
          "minLength": 1,
          "description": "Collector config for the local distributed-diagnosis session. Telemetry evidence never substitutes product acceptance."
        }
      }
    }
  }
}
