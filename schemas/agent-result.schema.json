{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/agent-result.schema.json",
  "title": "Portable Agent Result",
  "description": "The output of a delegated agent or sub-agent: receipts, usage, outcome, and model attestation. Platform-neutral; separates task outcome from orchestration attestation state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "assignment_id", "slice_id", "status",
    "receipts", "usage", "captured_at"
  ],
  "properties": {
    "schema": { "const": "artifact/agent-result" },
    "version": { "const": 1 },
    "assignment_id": { "type": "string", "minLength": 1 },
    "slice_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["PASS", "PARTIAL", "BLOCKED", "FAIL", "NOT_RUN"]
    },
    "orchestration_status": {
      "type": "string",
      "enum": ["healthy", "recovering", "degraded", "exception", "unverified"]
    },
    "receipts": {
      "type": "array",
      "items": { "$ref": "#/$defs/receipt" }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "tool_calls"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "turn_count": { "type": "integer", "minimum": 0 }
      }
    },
    "friction": {
      "type": "array",
      "items": { "type": "string" }
    },
    "model_evidence": { "$ref": "#/$defs/modelEvidence" },
    "captured_at": { "type": "string", "format": "date-time" },
    "actor_session": { "type": "string" },
    "host_attestation_ref": { "type": "string" }
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "acceptance_id", "claim", "status", "proof_kind",
        "dimensions", "expected", "observed", "environment",
        "exit_code", "captured_at"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "acceptance_id": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "claim_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "provenance": {
          "type": "string",
          "enum": ["runner", "external-verifier"]
        },
        "proof_kind": {
          "type": "string",
          "enum": [
            "static", "diff", "build", "unit", "integration", "api", "e2e",
            "browser", "performance", "security", "manual", "artifact",
            "transcript-review", "pipeline-run", "production-smoke"
          ]
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected": { "type": "string", "minLength": 1 },
        "observed": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "command": { "type": "string" },
        "exit_code": { "type": ["integer", "null"] },
        "artifact_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "size_bytes", "modified_at"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "modified_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "captured_at": { "type": "string", "format": "date-time" },
        "model_evidence": { "$ref": "#/$defs/modelEvidence" }
      }
    },
    "modelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_model", "requested_effort",
        "resolved_model", "resolved_effort",
        "observed_model", "observed_effort",
        "attestation_status", "fallback_reason"
      ],
      "properties": {
        "requested_model": { "type": "string", "minLength": 1 },
        "requested_effort": { "enum": ["low", "medium", "high", "unset"] },
        "resolved_model": { "type": ["string", "null"] },
        "resolved_effort": { "enum": ["low", "medium", "high", "unset", null] },
        "observed_model": { "type": ["string", "null"] },
        "observed_effort": { "enum": ["low", "medium", "high", "unset", null] },
        "attestation_status": {
          "type": "string",
          "enum": ["observed", "unobserved", "fallback", "unverified"]
        },
        "fallback_reason": { "type": "string" }
      }
    }
  }
}
