{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/decision.schema.json",
  "title": "Portable Decision",
  "description": "An owner or architect decision that constrains or guides execution. Platform-neutral; decisions are referenceable by plan slices and ledgers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "id", "summary", "rationale", "decided_at"
  ],
  "properties": {
    "schema": { "const": "artifact/decision" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^DEC-[0-9]+$" },
    "summary": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "option": { "type": "string" },
          "reason_rejected": { "type": "string" }
        }
      }
    },
    "decided_at": { "type": "string", "format": "date-time" },
    "decided_by": { "type": "string" },
    "affected_slices": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "revisit_if": { "type": "string" }
  }
}
