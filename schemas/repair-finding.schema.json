{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/repair-finding.schema.json",
  "title": "Repair Finding",
  "description": "A prompt-first pair-repair finding bound to the exact plan, candidate epoch, repository state, and observed surface before any mutation (AM-0003, REQ-022).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "finding_id", "raw_text", "plan_id", "candidate_epoch",
    "repository_state", "observed_surface", "classification", "binding"
  ],
  "properties": {
    "schema": { "const": "harness/repair-finding" },
    "version": { "const": 1 },
    "finding_id": { "type": "string", "minLength": 1 },
    "raw_text": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "candidate_epoch": { "type": "integer", "minimum": 0 },
    "repository_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_sha", "worktree_dirty"],
      "properties": {
        "head_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "worktree_dirty": { "type": "boolean" }
      }
    },
    "observed_surface": { "type": "string", "minLength": 1 },
    "classification": {
      "enum": [
        "implementation_defect",
        "missing_requirement",
        "changed_owner_intent",
        "evidence_defect",
        "environment_provider_issue",
        "unrelated"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_ref", "diff_ref", "evidence_refs", "authority_facts_agree"],
      "properties": {
        "ledger_ref": { "type": "string", "minLength": 1 },
        "diff_ref": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "authority_facts_agree": { "type": "boolean" }
      }
    },
    "ambiguity": {
      "description": "Fail-closed ambiguity handling when several active plans could own the finding.",
      "type": "object",
      "additionalProperties": false,
      "required": ["several_plans_candidate", "needs_user"],
      "properties": {
        "several_plans_candidate": { "type": "boolean" },
        "needs_user": { "type": "boolean" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
