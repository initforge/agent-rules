{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/telemetry-event.schema.json",
  "title": "Portable Telemetry Event",
  "description": "A single telemetry event recorded during an agent run. Supports model calls, tool invocations, subagent spawns, context loads, test executions, and the final outcome. Platform-neutral; uses logical classes not provider-specific tool names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "event_id", "session_id", "actor",
    "event", "timestamp", "outcome"
  ],
  "properties": {
    "schema": { "const": "artifact/telemetry-event" },
    "version": { "const": 1 },
    "event_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "session_id": { "type": "string", "minLength": 1 },
    "actor": {
      "type": "string",
      "enum": ["main", "worker", "unknown"]
    },
    "assignment_id": { "type": "string" },
    "event": {
      "type": "string",
      "enum": [
        "model_call", "tool_use", "subagent_spawn",
        "context_load", "test_run", "final_outcome"
      ]
    },
    "event_detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_call": {
          "type": "object",
          "properties": {
            "capability_class": { "type": "string" },
            "model_family": { "type": "string" },
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "reasoning_tokens": { "type": "integer", "minimum": 0 },
            "duration_ms": { "type": "integer", "minimum": 0 }
          }
        },
        "tool_use": {
          "type": "object",
          "properties": {
            "tool_class": { "type": "string" },
            "tool_name": { "type": "string" },
            "exit_code": { "type": ["integer", "null"] },
            "output_size_chars": { "type": "integer", "minimum": 0 },
            "duration_ms": { "type": "integer", "minimum": 0 }
          }
        },
        "subagent_spawn": {
          "type": "object",
          "properties": {
            "assignment_id": { "type": "string" },
            "capability_class": { "type": "string" },
            "resolved_model": { "type": "string" },
            "resolved_effort": { "type": "string" },
            "mission_length_chars": { "type": "integer", "minimum": 0 }
          }
        },
        "context_load": {
          "type": "object",
          "properties": {
            "source": { "type": "string" },
            "load_policy": { "type": "string" },
            "token_count": { "type": "integer", "minimum": 0 },
            "duration_ms": { "type": "integer", "minimum": 0 }
          }
        },
        "test_run": {
          "type": "object",
          "properties": {
            "command": { "type": "string" },
            "tests_passed": { "type": "integer", "minimum": 0 },
            "tests_failed": { "type": "integer", "minimum": 0 },
            "tests_skipped": { "type": "integer", "minimum": 0 },
            "duration_ms": { "type": "integer", "minimum": 0 }
          }
        },
        "final_outcome": {
          "type": "object",
          "properties": {
            "task_status": { "type": "string" },
            "orchestration_status": { "type": "string" },
            "completion_state": { "type": "string" },
            "host_attestation_ref": { "type": "string" },
            "evidence_stage": {
              "type": "string",
              "enum": [
                "SOURCE_VERIFIED", "TEST_VERIFIED", "NATIVE_SMOKE_VERIFIED",
                "LIVE_CANDIDATE", "LIVE_OBSERVED", "OPERATIONALLY_PROVEN", "LIVE_UNPROVEN"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "tool_class": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "outcome": { "type": "string", "minLength": 1 },
    "token_usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "friction": { "type": "array", "items": { "type": "string" } }
  }
}
