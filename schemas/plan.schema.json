{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/plan.schema.json",
  "title": "Portable Executable Plan",
  "description": "A plan contract at three detail levels (small/standard/resumable). Every level names outcome, scope, and acceptance. Standard adds requirements, decisions, change graph, and verification-by-claim. Resumable adds slices, amendments, checkpoints, and an evidence ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "level", "meta", "intent", "acceptance"
  ],
  "properties": {
    "schema": { "const": "artifact/plan" },
    "version": { "const": 1 },
    "level": {
      "type": "string",
      "enum": ["small", "standard", "resumable"]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "created_at", "updated_at", "source_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "original_request_hash": {
      "description": "Immutable sha256 hash of the original user request or conversation transcript that generated this plan.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "supersedes": {
      "description": "Reference to a prior plan this plan fully or partially supersedes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "superseded_at", "reason"],
      "properties": {
        "plan_id": { "type": "string", "minLength": 1 },
        "superseded_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 },
        "decisions_superseded": {
          "type": "array",
          "items": { "type": "string", "pattern": "^DEC-[0-9]+$" }
        }
      }
    },
    "unresolved_questions": {
      "description": "Questions that materially change architecture, scope, compatibility, migration, behavior, proof level, or irreversible decisions. All other questions are answerable from the repository.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "context", "impact"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "context": { "type": "string" },
          "impact": {
            "type": "string",
            "enum": ["architecture", "scope", "compatibility", "migration", "behavior", "proof_level", "irreversible"]
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "risk_classification", "in_scope", "non_goals"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1 },
        "risk_classification": {
          "type": "string",
          "enum": ["low", "medium", "high", "unclassified"]
        },
        "in_scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "non_goals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "scope_lock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_systems": { "type": "array", "items": { "type": "string" } },
            "forbidden_systems": { "type": "array", "items": { "type": "string" } },
            "owner_decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "statement"],
                "properties": {
                  "id": { "type": "string", "pattern": "^DEC-[0-9]+$" },
                  "statement": { "type": "string", "minLength": 1 },
                  "superseded_by": { "type": "string", "pattern": "^DEC-[0-9]+$" }
                }
              }
            }
          }
        },
        "open_questions": { "type": "array", "items": { "type": "string" } },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "category"],
            "properties": {
              "statement": { "type": "string", "minLength": 1 },
              "category": {
                "type": "string",
                "enum": ["fact", "assumption", "unknown", "user_decision"]
              }
            }
          }
        }
      }
    },
    "requirements": {
      "description": "Requirement references with IDs; standard+ level.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[0-9]+$" },
          "summary": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["original", "injection", "discovery", "external"]
          },
          "source_ref": { "type": "string" }
        }
      }
    },
    "decisions": {
      "description": "Owner or architect decisions; standard+ level. A later decision may supersede an earlier one via supersedes_id.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^DEC-[0-9]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string" },
          "supersedes_id": {
            "description": "ID of the decision this decision overrides. Null means this decision does not supersede any prior decision.",
            "type": ["string", "null"],
            "pattern": "^DEC-[0-9]+$"
          },
          "decided_by": { "type": "string" },
          "decided_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "repository_facts": {
      "description": "Discovered facts about the repository; standard+ level.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline": { "type": "string", "minLength": 1 },
        "branch": { "type": "string" },
        "architecture": { "type": "array", "items": { "type": "string" } },
        "existing_tests": { "type": "array", "items": { "type": "string" } },
        "reference_map": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "destination", "reuse", "deviation"],
            "properties": {
              "source": { "type": "string" },
              "destination": { "type": "string" },
              "reuse": { "type": "string" },
              "deviation": { "type": "string" }
            }
          }
        }
      }
    },
    "constraints_and_invariants": {
      "description": "Constraints and invariants the plan must preserve; standard+ level.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope_lock": {
          "type": "object",
          "properties": {
            "allowed_systems": { "type": "array", "items": { "type": "string" } },
            "forbidden_systems": { "type": "array", "items": { "type": "string" } }
          }
        },
        "negative_invariants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "migration_constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "change_graph": {
      "description": "A dependency-aware graph of changes; standard+ level. Richer than a linear checklist.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "area", "current_truth", "exact_change", "category"],
        "properties": {
          "id": { "type": "string", "pattern": "^CG-[0-9]+$" },
          "area": { "type": "string", "minLength": 1 },
          "current_truth": { "type": "string", "minLength": 1 },
          "exact_change": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": ["fact", "assumption", "unknown", "user_decision"]
          },
          "files": { "type": "array", "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "compatibility": { "type": "string" },
          "requirement_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ-[0-9]+$" }
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "proof_profile", "required_dimensions"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC[0-9]+$" },
          "claim": { "type": "string", "minLength": 1 },
          "proof_profile": { "type": "string", "minLength": 1 },
          "required_dimensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "required_kinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "static", "diff", "build", "unit", "integration", "api", "e2e",
                "browser", "performance", "security", "manual", "artifact",
                "transcript-review", "pipeline-run", "production-smoke"
              ]
            }
          },
          "requirement_ids": {
            "description": "Links this AC back to specific requirements it proves.",
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ-[0-9]+$" }
          }
        }
      }
    },
    "verification_matrix": {
      "description": "Maps requirements to acceptance criteria for verification-by-claim traceability.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "acceptance_ids"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^REQ-[0-9]+$" },
          "acceptance_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^AC[0-9]+$" }
          }
        }
      }
    },
    "path_ownership": {
      "description": "Path ownership boundaries; no two paths overlap between different owners.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exclusive_writers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "read_only_paths": { "type": "array", "items": { "type": "string" } },
        "forbidden_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "task_graph": {
      "description": "Work slices with ownership and dependencies; required for resumable level.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "depends_on", "capability_class", "acceptance_ids", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "work": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "capability_class": {
            "type": "string",
            "enum": ["economy", "standard", "expert", "unassigned"]
          },
          "write_paths": { "type": "array", "items": { "type": "string" } },
          "context_paths": { "type": "array", "items": { "type": "string" } },
          "forbidden_paths": { "type": "array", "items": { "type": "string" } },
          "acceptance_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "requirement_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ-[0-9]+$" }
          },
          "review_required": { "type": "boolean" },
          "rollback_point": { "type": "string" }
        }
      }
    },
    "amendments": {
      "description": "Plan amendments applied after plan creation. Each amendment explicitly supersedes prior decisions it conflicts with.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "changes", "supersedes_prior", "applied_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^AMD-[0-9]+$" },
          "reason": { "type": "string", "minLength": 1 },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "action", "detail"],
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "requirements", "decisions", "acceptance", "task_graph",
                    "change_graph", "constraints", "scope_lock", "path_ownership"
                  ]
                },
                "action": {
                  "type": "string",
                  "enum": ["added", "modified", "superseded", "removed"]
                },
                "target_id": { "type": "string" },
                "detail": { "type": "string", "minLength": 1 }
              }
            }
          },
          "supersedes_prior": { "type": "boolean" },
          "applied_at": { "type": "string", "format": "date-time" },
          "applied_by": { "type": "string" }
        }
      }
    },
    "checkpoints": {
      "description": "Session recovery points; resumable level.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slice_id", "commit", "summary", "next_action", "created_at"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "slice_id": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "next_action": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "evidence_ledger": {
      "description": "Accumulated evidence receipts; resumable level.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receipt_id", "acceptance_id", "status", "captured_at"],
        "properties": {
          "receipt_id": { "type": "string", "minLength": 1 },
          "acceptance_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
          "proof_kind": { "type": "string" },
          "dimensions": { "type": "array", "items": { "type": "string" } },
          "captured_at": { "type": "string", "format": "date-time" },
          "claim_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "automatic" },
        "shape": {
          "type": "string",
          "enum": ["small", "medium", "large", "resumable"]
        },
        "ledger": { "type": "string", "enum": ["off", "auto", "required"] },
        "strategy": {
          "type": "string",
          "enum": ["single-agent", "delegated", "parallel", "sequential-recovery"]
        },
        "max_agents": { "type": "integer", "minimum": 1 },
        "max_depth": { "type": "integer", "minimum": 0, "maximum": 2 },
        "effort_cap": { "type": "string", "enum": ["low", "medium", "high", "unset"] },
        "authorized_final_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["edit", "commit", "push", "deploy", "external-write", "none"]
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "early_signal", "prevention"],
        "properties": {
          "risk": { "type": "string", "minLength": 1 },
          "early_signal": { "type": "string", "minLength": 1 },
          "prevention": { "type": "string", "minLength": 1 },
          "regression_surface": { "type": "string" },
          "recovery": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "level": { "const": "standard" } },
        "required": ["level"]
      },
      "then": {
        "required": ["requirements", "decisions", "change_graph", "verification_matrix"],
        "properties": {
          "requirements": { "minItems": 1 },
          "decisions": { "minItems": 1 },
          "change_graph": { "minItems": 1 },
          "verification_matrix": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "level": { "const": "resumable" } },
        "required": ["level"]
      },
      "then": {
        "required": ["requirements", "decisions", "change_graph", "verification_matrix", "task_graph"],
        "properties": {
          "requirements": { "minItems": 1 },
          "decisions": { "minItems": 1 },
          "change_graph": { "minItems": 1 },
          "verification_matrix": { "minItems": 1 },
          "task_graph": { "minItems": 1 }
        }
      }
    }
  ]
}
