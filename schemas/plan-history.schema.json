{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-rules.local/schemas/plan-history.schema.json",
  "title": "Compacted plan history",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "planId",
    "originalIntentSha256",
    "terminalStatus",
    "compactedAt",
    "requirements",
    "claims",
    "decisions",
    "evidenceRefs",
    "retainedArtifacts",
    "quarantinedArtifacts",
    "deletedArtifacts"
  ],
  "properties": {
    "schema": { "const": "harness/plan-history" },
    "version": { "const": 1 },
    "planId": { "type": "string", "minLength": 1 },
    "originalIntentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "terminalStatus": {
      "type": "string",
      "enum": ["COMPLETE", "CLOSED", "SUPERSEDED", "CANCELLED"]
    },
    "compactedAt": { "type": "string", "format": "date-time" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "claimIds": { "type": "array", "items": { "type": "string" } },
          "taskIds": { "type": "array", "items": { "type": "string" } },
          "verification": { "type": "string" }
        }
      }
    },
    "claims": { "type": "array", "items": { "type": "object" } },
    "decisions": { "type": "array", "items": { "type": "object" } },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "retainedArtifacts": { "type": "array", "items": { "type": "string" } },
    "quarantinedArtifacts": { "type": "array", "items": { "type": "string" } },
    "deletedArtifacts": { "type": "array", "items": { "type": "string" } },
    "owner": { "type": "string" },
    "notes": { "type": "string" }
  }
}
