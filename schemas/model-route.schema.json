{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/model-route.schema.json",
  "title": "Portable Model Route",
  "description": "A requested→resolved→observed triple for model and effort routing. Platform-neutral; uses capability classes (economy/standard/expert) not provider model IDs for the request. Distinguishes what was asked for, what the host resolved, and what was independently observed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "assignment_id", "capability_class",
    "requested", "resolved", "observed", "attested_at"
  ],
  "properties": {
    "schema": { "const": "artifact/model-route" },
    "version": { "const": 1 },
    "assignment_id": { "type": "string", "minLength": 1 },
    "capability_class": {
      "type": "string",
      "enum": ["economy", "standard", "expert", "unassigned"]
    },
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_class", "effort"],
      "properties": {
        "capability_class": {
          "type": "string",
      "enum": ["utility", "economy", "standard", "expert", "unassigned"]
        },
        "effort": { "enum": ["low", "medium", "high", "unset"] },
        "provider_preference": { "type": "string" }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "model_family": { "type": "string" },
        "model_version": { "type": "string" },
        "effort": { "enum": ["low", "medium", "high", "unset"] },
        "fallback_reason": { "type": "string" },
        "resolved_at": { "type": "string", "format": "date-time" }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": ["string", "null"] },
        "model_family": { "type": ["string", "null"] },
        "model_version": { "type": ["string", "null"] },
        "effort": { "enum": ["low", "medium", "high", "unset", null] },
        "attestation_status": {
          "type": "string",
          "enum": ["observed", "unobserved", "fallback", "unverified"]
        }
      }
    },
    "attested_at": { "type": "string", "format": "date-time" },
    "denial_behavior": {
      "type": "string",
      "enum": ["fail_closed", "fail_closed_partial", "fail_open", "unset"]
    }
  }
}
