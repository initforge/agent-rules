{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/claim-evidence.schema.json",
  "title": "Portable Claim-Evidence Record",
  "description": "A claim-to-evidence record that links a requirement to a verifiable statement, evidence class, status, artifact, and runtime metadata. Platform-neutral; supports audit-grade traceability from requirement through claim to evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "claim_id", "requirement_id",
    "statement", "evidence_class", "status", "timestamp"
  ],
  "properties": {
    "schema": { "const": "artifact/claim-evidence" },
    "version": { "const": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "claim_id": { "type": "string", "minLength": 1 },
    "requirement_id": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "evidence_class": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "PARTIALLY_VERIFIED",
        "UNVERIFIED",
        "BLOCKED",
        "NOT_APPLICABLE",
        "FAILED"
      ]
    },
    "evidence_stage": {
      "type": "string",
      "enum": [
        "SOURCE_VERIFIED",
        "TEST_VERIFIED",
        "NATIVE_SMOKE_VERIFIED",
        "LIVE_CANDIDATE",
        "LIVE_OBSERVED",
        "OPERATIONALLY_PROVEN",
        "LIVE_UNPROVEN"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED", "UNVERIFIED"]
    },
    "evidence_artifact": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "string" },
        "host_os": { "type": "string" },
        "runtime_version": { "type": "string" }
      }
    },
    "verifier": { "type": "string" },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
