{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/schemas/plan-reconciliation-admission.schema.json",
  "title": "Complete-set plan admission",
  "type": "object",
  "additionalProperties": false,
  "required": ["additionId", "sourceIntent", "owner", "authorityBoundary", "affectedItems", "requestedEffect", "acceptance", "proposedPhase", "dependencies", "status"],
  "properties": {
    "additionId": { "type": "string", "minLength": 1 },
    "sourceIntent": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "authorityBoundary": { "type": "string", "minLength": 1 },
    "affectedItems": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "requestedEffect": { "type": "string", "minLength": 1 },
    "acceptance": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "proposedPhase": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "status": { "enum": ["PROPOSED", "ADMITTED", "BLOCKED", "DEFERRED", "REJECTED", "SUPERSEDED"] }
  }
}
