{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-rules/proof-receipt/v1",
  "title": "Proof Receipt",
  "description": "Durable router output: selected + omitted proof, escalation decisions, results, final status (owner §12).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "task_id", "repository", "changed_scope", "claims", "risks", "selected_profile", "selected", "omitted", "escalation_decisions", "environment", "results", "evidence_refs", "final_status", "generated_at"],
  "properties": {
    "schema": { "const": "agent-rules/proof-receipt/v1" },
    "version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "changed_scope": { "type": "array", "items": { "type": "string" } },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim"],
        "properties": {
          "claim_id": { "type": "string" },
          "claim": { "type": "string" }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "selected_profile": { "type": "string" },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "proof_id", "category", "sufficiency", "environment", "escalation_path"],
        "properties": {
          "claim_id": { "type": "string" },
          "proof_id": { "type": "string" },
          "category": { "enum": ["static", "unit", "contract", "integration", "api", "browser", "live", "security", "performance", "data", "packaging", "other"] },
          "sufficiency": { "type": "string" },
          "environment": { "type": "string" },
          "result": { "enum": ["PASS", "PARTIAL", "BLOCKED", "UNSUPPORTED", "PRE-EXISTING", "NEEDS_USER"] },
          "evidence_path": { "type": "string" },
          "limitations": { "type": "string" },
          "escalation_path": { "type": "string" }
        }
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "reason", "why_safe", "escalation_condition"],
        "properties": {
          "category": { "enum": ["static", "unit", "contract", "integration", "api", "browser", "live", "security", "performance", "data", "packaging", "other"] },
          "reason": { "type": "string" },
          "why_safe": { "type": "string" },
          "escalation_condition": { "type": "string" }
        }
      }
    },
    "escalation_decisions": { "type": "array", "items": { "type": "string" } },
    "environment": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proof_id", "status"],
        "properties": {
          "proof_id": { "type": "string" },
          "status": { "enum": ["PASS", "PARTIAL", "BLOCKED", "UNSUPPORTED", "PRE-EXISTING", "NEEDS_USER"] }
        }
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "final_status": { "enum": ["PASS", "PARTIAL", "BLOCKED", "UNSUPPORTED", "PRE-EXISTING", "NEEDS_USER"] },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
