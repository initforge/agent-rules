{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/schemas/compact-progress-receipt.schema.json",
  "title": "Compact reachable progress receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceIdentity", "planId", "planRevision", "affectedScope", "claimCoverage", "counts", "strongestVerificationLevel", "fresh", "blocker", "artifactUri", "resumeConditions"],
  "properties": {
    "schema": { "const": "harness/compact-progress-receipt/v1" },
    "sourceIdentity": { "type": "string", "minLength": 1 },
    "planId": { "type": "string", "minLength": 1 },
    "planRevision": { "type": "integer", "minimum": 0 },
    "affectedScope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "claimCoverage": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "counts": { "$ref": "reachable-progress.schema.json#/$defs/counts" },
    "strongestVerificationLevel": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
    "fresh": { "type": "boolean" },
    "blocker": { "type": ["string", "null"], "enum": [null, "DEPENDENCY", "VERIFY_UNAVAILABLE", "AUTHORITY", "SPEC", "CAPABILITY", "ENVIRONMENT", "FAILURE"] },
    "artifactUri": { "type": "string", "minLength": 1 },
    "terminalReason": { "type": "string" },
    "resumeConditions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
