{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/route-parity-case.schema.json",
  "title": "Typed route parity case",
  "description": "A bounded corpus case used to compare the canonical TypeScript route policy with host adapters without turning the corpus into a second router.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "phase", "claim", "risk", "domain", "stack", "prompt", "workspace", "expected"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "phase": { "enum": ["discussion", "plan", "implementation", "verification", "review"] },
    "claim": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["S0", "S1", "S2", "S3"] },
    "domain": { "type": "string", "minLength": 1 },
    "stack": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation"],
      "properties": {
        "activation": { "enum": ["generic", "5fedu-marker"] }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "stack", "capability", "provider", "verifier", "confidence", "context_cost", "fallback"],
      "properties": {
        "primary": { "type": ["string", "null"] },
        "stack": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "capability": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "verifier": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "context_cost": { "type": "integer", "minimum": 0 },
        "fallback": { "type": "string", "minLength": 1 }
      }
    }
  }
}
