{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/schemas/host-kit/receipt.schema.json",
  "title": "Host Kit Receipt",
  "description": "Portable receipt for host-kit role work. Model-neutral; no provider or model IDs present. Receipts record decisions, status, and fallback actions for all role work.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "receipt_id", "role", "issued_at", "status", "decision", "evidence_refs", "authority", "fallback"],
  "properties": {
    "schema": { "const": "host-kit/receipt" },
    "version": { "const": 1 },
    "receipt_id": { "type": "string", "minLength": 1 },
    "role": {
      "type": "string",
      "enum": ["coordinator", "architect-integrator", "implementer", "utility", "verifier", "reviewer", "specialist", "adjudicator"]
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["issued", "accepted", "rejected", "escalated", "superseded"]
    },
    "decision": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "authority": {
      "type": "string",
      "enum": ["host", "delegate", "read-only", "advisory", "override"]
    },
    "fallback": { "type": "string", "enum": ["deny", "halt", "request-clarification", "escalate", "defer", "block"] }
  }
}