{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/worktree-inventory.schema.json",
  "title": "Read-only Worktree Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "repository", "worktrees", "branches", "stashes"],
  "properties": {
    "schema": { "const": "artifact/worktree-inventory" },
    "version": { "const": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "worktrees": { "type": "array", "items": { "$ref": "#/$defs/worktree" } },
    "branches": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "stashes": { "type": "array", "items": { "$ref": "#/$defs/stash" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitObjectId": { "type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$" },
    "classification": { "const": "PENDING_REVIEW" },
    "worktree": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "branch", "head", "tree", "dirty_fingerprint", "status", "untracked", "classification"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }, "branch": { "type": ["string", "null"] },
        "head": { "$ref": "#/$defs/gitObjectId" }, "tree": { "$ref": "#/$defs/gitObjectId" }, "dirty_fingerprint": { "$ref": "#/$defs/hash" },
        "status": { "type": "array" }, "untracked": { "type": "array", "items": { "$ref": "#/$defs/untracked" } },
        "classification": { "$ref": "#/$defs/classification" }
      }
    },
    "untracked": {
      "type": "object", "additionalProperties": false, "required": ["path", "kind", "sha256"],
      "properties": { "path": { "type": "string" }, "kind": { "enum": ["file", "symlink", "other"] }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["name", "head", "tree", "classification"],
      "properties": { "name": { "type": "string" }, "head": { "$ref": "#/$defs/gitObjectId" }, "tree": { "$ref": "#/$defs/gitObjectId" }, "classification": { "$ref": "#/$defs/classification" } }
    },
    "stash": {
      "type": "object", "additionalProperties": false, "required": ["reference", "message", "head", "tree", "classification"],
      "properties": { "reference": { "type": "string" }, "message": { "type": "string" }, "head": { "$ref": "#/$defs/gitObjectId" }, "tree": { "$ref": "#/$defs/gitObjectId" }, "classification": { "$ref": "#/$defs/classification" } }
    }
  }
}
