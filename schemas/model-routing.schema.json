{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/model-routing.schema.json",
  "title": "Portable Model Routing Policy",
  "description": "A model routing policy that maps task classes to risk, complexity, initial model class, effort, escalation and fallback rules, context/retry/cost budgets, and independent review requirements. Platform-neutral; supports deterministic routing and fallback governance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "task_class", "risk",
    "initial_model_class", "effort"
  ],
  "properties": {
    "schema": { "const": "artifact/model-routing" },
    "version": { "const": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "task_class": { "type": "string", "minLength": 1 },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "complexity": { "type": "string" },
    "initial_model_class": {
      "type": "string",
      "enum": ["utility", "economy", "standard", "expert", "unassigned"]
    },
    "effort": {
      "type": "string",
      "enum": ["low", "medium", "high", "unset"]
    },
    "escalation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trigger", "target_model_class"],
        "properties": {
          "trigger": { "type": "string", "minLength": 1 },
          "target_model_class": {
            "type": "string",
            "enum": ["utility", "economy", "standard", "expert", "unassigned"]
          },
          "reason": { "type": "string" }
        }
      }
    },
    "fallback_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "fallback_model_class"],
        "properties": {
          "condition": { "type": "string", "minLength": 1 },
          "fallback_model_class": {
            "type": "string",
            "enum": ["utility", "economy", "standard", "expert", "unassigned"]
          },
          "reason": { "type": "string" }
        }
      }
    },
    "context_budget": { "type": "integer", "minimum": 0 },
    "retry_budget": { "type": "integer", "minimum": 0 },
    "cost_budget": { "type": "number", "minimum": 0 },
    "independent_review_required": { "type": "boolean" }
  }
}
