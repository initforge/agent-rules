{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/skill-catalog.schema.json",
  "title": "Agent Rules skill ownership catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source_of_truth", "skills"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "source_of_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "routing", "catalog"],
      "properties": {
        "skill": { "const": "<skill-root>/SKILL.md" },
        "routing": { "const": "<skill-root>/ROUTE.json" },
        "catalog": { "const": "skills/catalog.json" }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "source", "route", "scope", "owner", "consumers",
          "duplicate_semantics", "target_catalog", "disposition",
          "compatibility_period", "removal_gate"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "source": { "type": "string", "pattern": "^(skills|profiles/[^/]+/skills)/.+/SKILL\\.md$" },
          "route": { "type": "string", "pattern": "^(skills|profiles/[^/]+/skills)/.+/ROUTE\\.json$" },
          "scope": { "enum": ["core", "profile"] },
          "owner": { "type": "string", "minLength": 1 },
          "consumers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "duplicate_semantics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["with", "signals", "resolution"],
              "properties": {
                "with": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "signals": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
                "resolution": { "type": "string", "minLength": 1 }
              }
            }
          },
          "target_catalog": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["retain", "migrate-to-policy", "compatibility-facade", "profile-explicit"] },
          "compatibility_period": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "until"],
            "properties": {
              "status": { "enum": ["active", "compatibility", "candidate", "deprecated"] },
              "until": { "type": ["string", "null"] }
            }
          },
          "removal_gate": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
