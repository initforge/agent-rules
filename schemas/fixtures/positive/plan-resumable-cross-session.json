        "Dual-write produces identical data in both stores"
      ],
      "verification": {
        "proof_kinds": ["integration"],
        "dimensions": ["reconciliation", "failure-path"]
      },
      "evidence_requirements": ["dual_write_reconciliation"],
      "rollback": "Disable dual-write adapter",
      "portability": {}
    },
    {
