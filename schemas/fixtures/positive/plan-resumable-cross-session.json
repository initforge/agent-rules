      "statement": "Extract orders before payments",
      "rationale": "Orders have fewer dependencies",
      "decided_by": "architect",
      "decided_at": "2026-07-25T14:00:00Z"
    },
    {
      "id": "DEC-002",
      "statement": "Use dual-write during migration",
      "rationale": "Zero-downtime requirement",
      "decided_by": "architect",
      "decided_at": "2026-07-25T14:10:00Z"
    }
  ],
  "tasks": [
