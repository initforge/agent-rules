      "verification": {
        "proof_kinds": ["integration", "e2e"],
        "dimensions": ["outcome", "integration", "regression"]
      },
      "evidence_requirements": ["gateway_routing_test"],
      "rollback": "Restore monolith routing",
      "portability": {}
    },
    {
      "id": "T4",
      "objective": "Reconcile data after migration",
      "requirements": ["REQ-004"],
