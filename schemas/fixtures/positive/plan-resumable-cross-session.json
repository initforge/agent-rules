      "id": "T1",
      "objective": "Create order service stub with health endpoint",
      "requirements": ["REQ-001"],
      "file_ownership": ["services/order/"],
      "acceptance_criteria": [
        "Order service starts and responds to health check"
      ],
      "verification": {
        "proof_kinds": ["unit"],
        "dimensions": ["outcome"]
      },
      "evidence_requirements": ["health_check_output"],
      "rollback": "Remove order service",
      "portability": {
        "platforms": ["linux", "darwin"],
        "constraints": ["postgres >= 15"]
      }
    },
    {
      "id": "T2",
      "objective": "Add dual-write to monolith order module",
      "requirements": ["REQ-002"],
      "file_ownership": ["monolith/src/orders/dual_write.rs"],
