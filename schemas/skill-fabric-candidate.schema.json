{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/skill-fabric-candidate.schema.json",
  "title": "Candidate skill fabric entry",
  "description": "A non-active, composable skill/domain candidate. Candidate entries are planning inventory and cannot be loaded by the runtime graph. The same schema also carries the machine-checkable contracts for the external-source lock envelope, the source-lock policy mirror, and the selected-set projection manifest stored in skills/candidate-fabric.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "domain", "owner", "status", "phases", "trigger", "conflicts", "inputs", "outputs", "required_capabilities", "evaluation", "activation_gate", "removal_path"],
  "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "domain": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "enum": ["candidate", "selected", "rejected", "materialized"] },
        "phases": { "type": "array", "minItems": 1, "items": { "enum": ["discussion", "plan", "implementation", "verification", "review"] }, "uniqueItems": true },
        "activation_class": { "$ref": "#/$defs/activationClass" },
        "materialization_receipt": { "$ref": "#/$defs/materializationReceipt" },
        "route_receipt": { "$ref": "#/$defs/routeReceipt" },
        "rollback_receipt": { "type": ["string", "null"] },
    "trigger": { "type": "object", "additionalProperties": false, "required": ["facts", "never_from_keywords_alone"], "properties": { "facts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "never_from_keywords_alone": { "const": true } } },
    "conflicts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "outputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "required_capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "evaluation": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "activation_gate": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "removal_path": { "type": "string", "minLength": 1 },
    "source_lock_policy": { "$ref": "#/$defs/sourceLockPolicy" },
    "selection_manifest": { "$ref": "#/$defs/selectionManifest" },
    "external_source_matrix": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/externalSource" }
    }
  },
  "$defs": {
    "sourceLockPolicy": {
      "type": "object",
      "description": "Mirror of the plan-local source-lock seed policy. The seed (.agent/plans/<plan>/source-lock.seed.json) is the plan-time authority; validators assert this mirror stays equal.",
      "additionalProperties": false,
      "required": [
        "immutable_resolution_required",
        "hash_required_before_install",
        "license_review_required",
        "rollback_required",
        "shell_strings_forbidden",
        "selected_skill_score_minimum",
        "install_selected_set_to_all_detected_hosts"
      ],
      "properties": {
        "immutable_resolution_required": { "const": true },
        "hash_required_before_install": { "const": true },
        "license_review_required": { "const": true },
        "rollback_required": { "const": true },
        "shell_strings_forbidden": { "const": true },
        "selected_skill_score_minimum": { "const": 70 },
        "install_selected_set_to_all_detected_hosts": { "const": true }
      }
    },
    "selectionManifest": {
      "type": "object",
      "description": "Selected external-skill set and per-host projection receipts. Written by the runtime installer/reconciler after live host detection; the S2 validators fail closed when a selected skill is missing or hash-mismatched on any detected host.",
      "additionalProperties": false,
      "required": ["detected_hosts", "selected_external_skills", "projection_receipts", "basis"],
      "properties": {
        "detected_hosts": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true },
        "selected_external_skills": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "uniqueItems": true },
        "projection_receipts": {
          "type": "object",
          "description": "Map of selected external skill id -> host -> { path, sha256 } receipt for the materialized SKILL.md content.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "externalSource": {
      "type": "object",
      "description": "Immutable external source lock: pinned revision, content hash, license, trust, security-review, portability, route precision, benchmark, and install/rollback records. Mutable or unpinned refs, missing hashes, unestablished licenses, and missing rollback plans fail closed.",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "domain",
        "source",
        "selection",
        "adoption",
        "status",
        "lock",
        "qualification",
        "conflicts",
        "install"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "kind": { "enum": ["spec", "skill-repository", "app-mcp", "mcp-server", "mobile-provider", "verifier-provider"] },
        "domain": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "pattern": "^https://" },
        "selection": { "enum": ["reference", "candidate", "selected-explicit", "selected-adapter", "materialized"] },
        "adoption": { "enum": ["reference-or-on-demand", "on-demand-binding", "diagnostic-only"] },
        "status": { "enum": ["candidate", "selected", "rejected", "materialized"] },
        "activation_class": { "$ref": "#/$defs/activationClass" },
        "install_authority": { "$ref": "#/$defs/installAuthority" },
        "permission_review": { "$ref": "#/$defs/permissionReview" },
        "materialization_receipt": { "$ref": "#/$defs/materializationReceipt" },
        "route_receipt": { "$ref": "#/$defs/routeReceipt" },
        "content_materialization": { "$ref": "#/$defs/contentMaterialization" },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "shell_strings", "materialization"],
          "properties": {
            "mode": { "const": "never-implicit" },
            "shell_strings": { "const": "forbidden" },
            "materialization": { "enum": ["none", "on-demand", "explicit"] }
          }
        },
        "lock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "immutable_revision",
            "content_hash",
            "license",
            "trust",
            "security_review",
            "portability",
            "route_precision",
            "benchmark",
            "rollback"
          ],
          "properties": {
            "immutable_revision": {
              "type": "object",
              "description": "Immutable pin. Branch names (mutable) are forbidden as pins; a default-branch movement never changes a recorded commit SHA.",
              "additionalProperties": false,
              "required": ["kind", "value", "resolved_from", "resolved_at"],
              "properties": {
                "kind": { "enum": ["commit", "tag", "version"] },
                "value": { "type": "string", "minLength": 7 },
                "resolved_from": { "type": "string", "minLength": 1 },
                "resolved_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
              }
            },
            "content_hash": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "value", "source"],
              "properties": {
                "algorithm": { "enum": ["sha256", "git-tree-sha1"] },
                "value": { "type": "string", "minLength": 40, "maxLength": 64 },
                "source": { "type": "string", "minLength": 1 }
              }
            },
            "license": {
              "type": "object",
              "additionalProperties": false,
              "required": ["spdx", "source_file", "review_state"],
              "properties": {
                "spdx": { "type": "string", "minLength": 1 },
                "source_file": { "type": "string", "minLength": 1 },
                "review_state": { "enum": ["pending-review", "reviewed", "blocked", "unresolved"] }
              }
            },
            "trust": {
              "type": "object",
              "additionalProperties": false,
              "required": ["classification", "decision"],
              "properties": {
                "classification": { "enum": ["official", "vendor", "community", "unknown"] },
                "decision": { "type": "string", "minLength": 1 }
              }
            },
            "security_review": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "evidence"],
              "properties": {
                "state": { "enum": ["pending", "approved", "rejected"] },
                "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
              }
            },
            "portability": {
              "type": "object",
              "additionalProperties": false,
              "required": ["skillmd", "route_sidecar", "hosts"],
              "properties": {
                "skillmd": { "const": true },
                "route_sidecar": { "const": true },
                "hosts": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true }
              }
            },
            "route_precision": {
              "type": "object",
              "additionalProperties": false,
              "required": ["route_owner", "sidecar", "precision", "signals"],
              "properties": {
                "route_owner": { "type": "string", "minLength": 1 },
                "sidecar": { "const": "ROUTE.json" },
                "precision": { "enum": ["high", "medium", "low"] },
                "signals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
              }
            },
            "benchmark": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "evidence"],
              "properties": {
                "state": { "enum": ["pending", "passed", "rejected"] },
                "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
              }
            },
            "rollback": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plan", "record"],
              "properties": {
                "plan": { "type": "string", "minLength": 1 },
                "record": { "type": ["string", "null"] }
              }
            }
          }
        },
        "qualification": {
          "type": "object",
          "description": "Weighted qualification receipt: score recomputed by validators from lock/benchmark evidence, compared against no-skill/local composition, threshold 70.",
          "additionalProperties": false,
          "required": ["score", "threshold", "result", "compared", "factors", "reasons"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "threshold": { "const": 70 },
            "result": { "enum": ["passed", "below-threshold", "rejected"] },
            "compared": { "const": "no-skill/local-composition" },
            "factors": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_integrity", "license", "security_review", "verified_task_success", "portability", "route_precision", "maintenance_cost"],
              "properties": {
                "source_integrity": { "$ref": "#/$defs/qualFactor" },
                "license": { "$ref": "#/$defs/qualFactor" },
                "security_review": { "$ref": "#/$defs/qualFactor" },
                "verified_task_success": { "$ref": "#/$defs/qualFactor" },
                "portability": { "$ref": "#/$defs/qualFactor" },
                "route_precision": { "$ref": "#/$defs/qualFactor" },
                "maintenance_cost": { "$ref": "#/$defs/qualFactor" }
              }
            },
            "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["with", "resolved", "resolution"],
            "properties": {
              "with": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "resolved": { "type": "boolean" },
              "resolution": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "qualFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "max", "basis"],
      "properties": {
        "score": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "activationClass": {
      "type": "string",
      "enum": ["NATIVE", "POLICY", "ROUTED", "EXPLICIT", "ON_DEMAND", "PROVIDER_ROUTE", "SEMANTIC_DISCOVERY"]
    },
    "installAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holder", "mode", "evidence"],
      "properties": {
        "holder": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["none", "owner-approved-plan", "explicit-operator-command"] },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "permissionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence"],
      "properties": {
        "state": { "enum": ["pending", "approved", "blocked"] },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "materializationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifact_path", "route_path", "sha256", "materialized_at"],
      "properties": {
        "status": { "enum": ["MATERIALIZED_SKILL", "MATERIALIZED_PROVIDER", "BLOCKED_WITH_EXACT_REASON"] },
        "artifact_path": { "type": "string", "minLength": 1 },
        "route_path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "materialized_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "reason": { "type": "string" },
        "unblock_action": { "type": "string" }
      }
    },
    "routeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_path", "activation_class", "trigger_facts", "route_precision", "sha256"],
      "properties": {
        "route_path": { "type": "string", "minLength": 1 },
        "activation_class": { "$ref": "#/$defs/activationClass" },
        "trigger_facts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "route_precision": { "enum": ["high", "medium", "low"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "contentMaterialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["MATERIALIZED", "BLOCKED"] },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
