{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/execution-contract.schema.json",
  "title": "Effective Execution Contract Artifacts",
  "description": "Portable contracts for the generation-based current pointer, compiled effective execution contract with capability preservation, and compact review bundle.",
  "oneOf": [
    { "$ref": "#/$defs/currentPointer" },
    { "$ref": "#/$defs/effectiveExecutionContract" },
    { "$ref": "#/$defs/reviewBundle" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^(?:M11-R[0-9]{2,}|REQ-[0-9]{3})$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "currentPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "version", "kind", "generation", "work_id", "plan_id", "plan_root",
        "original", "canonical_ledger", "effective_chain_tip",
        "candidate_chain_tip", "contract", "atomicity"
      ],
      "properties": {
        "schema": { "const": "artifact/execution-contract" },
        "version": { "const": 1 },
        "kind": { "const": "current-pointer" },
        "generation": { "type": "integer", "minimum": 1 },
        "work_id": { "type": "string", "minLength": 1 },
        "plan_id": { "type": "string", "minLength": 1 },
        "plan_root": { "$ref": "#/$defs/relativePath" },
        "original": { "$ref": "#/$defs/artifactRef" },
        "canonical_ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "observed_revision", "observed_effective_sha256", "plan_status", "execution_state"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "observed_revision": { "type": "integer", "minimum": 0 },
            "observed_effective_sha256": { "$ref": "#/$defs/sha256" },
            "plan_status": { "enum": ["ACTIVE", "PLANNED", "DRAFT", "APPROVED", "ADOPTED", "COMPLETED", "SUPERSEDED", "PARTIAL", "BLOCKED", "needs-remediation"] },
            "execution_state": { "type": "string", "minLength": 1 }
          }
        },
        "effective_chain_tip": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amendment_id", "path", "sha256"],
          "properties": {
            "amendment_id": { "type": "string", "pattern": "^AM-[0-9]{4}$" },
            "path": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "candidate_chain_tip": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amendment_id", "status", "path", "sha256"],
          "properties": {
            "amendment_id": { "type": "string", "pattern": "^AM-[0-9]{4}$" },
            "status": {
              "enum": [
                "OWNER_APPROVED_PENDING_CANONICAL_ACTIVATION",
                "OWNER_APPROVED_PENDING_ACTIVATION",
                "OWNER_APPROVED_EFFECTIVE",
                "REJECTED"
              ]
            },
            "path": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "schema_path", "requirement_ids", "status"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "schema_path": { "$ref": "#/$defs/relativePath" },
            "requirement_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/requirementId" }
            },
            "status": {
              "enum": ["PENDING_CANONICAL_ACTIVATION", "EFFECTIVE", "SUPERSEDED"]
            }
          }
        },
        "atomicity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol", "expected_previous_generation", "commit_target",
            "activation_state", "updated_at"
          ],
          "properties": {
            "protocol": { "const": "generation-compare-and-swap" },
            "expected_previous_generation": { "type": "integer", "minimum": 0 },
            "commit_target": { "const": ".agent/current.json" },
            "activation_state": {
              "enum": [
                "BOOTSTRAP_POINTER",
                "BOOTSTRAP_UNCERTIFIED",
                "CANONICALLY_ACTIVATED"
              ]
            },
            "updated_at": { "type": "string", "format": "date-time" }
          }
        },
        "supersession": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transaction_id", "previous_work_id", "previous_plan_id", "reason", "changed_at"],
          "properties": {
            "transaction_id": { "type": "string", "minLength": 1 },
            "previous_work_id": { "type": "string", "minLength": 1 },
            "previous_plan_id": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 },
            "changed_at": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "capabilityPreservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_disposition", "unimplemented_backlog", "entries"],
      "properties": {
        "default_disposition": { "const": "CARRIED" },
        "unimplemented_backlog": { "const": "REMAINS_EFFECTIVE" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["concept", "source_requirement_ids", "disposition", "reason"],
            "properties": {
              "concept": { "type": "string", "minLength": 1 },
              "source_requirement_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "disposition": {
                "enum": ["CARRIED", "SUPERSEDED_CONFLICT", "REJECTED_OBSOLETE"]
              },
              "successor_requirement_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/requirementId" }
              },
              "reason": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "disposition": { "enum": ["SUPERSEDED_CONFLICT", "REJECTED_OBSOLETE"] }
                  },
                  "required": ["disposition"]
                },
                "then": { "required": ["successor_requirement_ids"] }
              }
            ]
          }
        }
      }
    },
    "effectiveExecutionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "version", "kind", "contract_id", "plan_id", "status",
        "original_sha256", "effective_plan_sha256", "source_chain",
        "requirements", "capability_preservation", "execution_policy"
      ],
      "properties": {
        "schema": { "const": "artifact/execution-contract" },
        "version": { "const": 1 },
        "kind": { "const": "effective-execution-contract" },
        "contract_id": { "type": "string", "minLength": 1 },
        "plan_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PENDING_CANONICAL_ACTIVATION", "EFFECTIVE", "SUPERSEDED"] },
        "original_sha256": { "$ref": "#/$defs/sha256" },
        "effective_plan_sha256": { "$ref": "#/$defs/sha256" },
        "source_chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "path", "sha256", "status"],
            "properties": {
              "artifact_id": { "type": "string", "minLength": 1 },
              "path": { "$ref": "#/$defs/relativePath" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "status": { "enum": ["IMMUTABLE", "EFFECTIVE", "PENDING_CANONICAL_ACTIVATION", "SUPERSEDED_HISTORY"] }
            }
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirementId" }
        },
        "capability_preservation": { "$ref": "#/$defs/capabilityPreservation" },
        "execution_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy", "main_role", "normal_native_children",
            "burst_native_children", "child_target_scope",
            "normal_role_composition", "burst_role_composition",
            "adaptive_scale_down", "speed_slo",
            "vitest_parent_limit_per_project", "vitest_parent_workers",
            "vitest_file_parallelism", "vitest_full_suite_exclusive",
            "baseline_hardware",
            "local_authority", "cleanup_policy"
          ],
          "properties": {
            "strategy": { "const": "FRONTSTAGE_FIRST_CONTRACT_SAFE" },
            "main_role": { "const": "COORDINATOR_ONLY" },
            "normal_native_children": { "const": 8 },
            "burst_native_children": { "const": 10 },
            "child_target_scope": { "const": "LARGE_ACTIVE_RUN" },
            "normal_role_composition": {
              "const": { "writers": 4, "verifiers": 2, "reviewers": 1, "integration_preparation": 1 }
            },
            "burst_role_composition": {
              "const": { "writers": 5, "verifiers": 2, "reviewers": 2, "integration_preparation": 1 }
            },
            "adaptive_scale_down": { "const": true },
            "speed_slo": {
              "type": "object",
              "additionalProperties": false,
              "required": ["small_pair_no_regression", "parallel_p50_reduction_min_percent", "parallel_p50_reduction_stretch_percent", "track_p95"],
              "properties": {
                "small_pair_no_regression": { "const": true },
                "parallel_p50_reduction_min_percent": { "const": 70 },
                "parallel_p50_reduction_stretch_percent": { "const": 90 },
                "track_p95": { "const": true }
              }
            },
            "vitest_parent_limit_per_project": { "const": 2 },
            "vitest_parent_workers": { "const": 1 },
            "vitest_file_parallelism": { "const": false },
            "vitest_full_suite_exclusive": { "const": true },
            "baseline_hardware": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ram_gib", "cpu_class", "weaker_hosts_scale_down"],
              "properties": {
                "ram_gib": { "const": 16 },
                "cpu_class": { "const": "intel-core-i7-12700h-class" },
                "weaker_hosts_scale_down": { "const": true }
              }
            },
            "local_authority": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "checkpoint", "commit", "local_merge",
                "named_nonprod_dev_volume_reset", "push", "deploy",
                "production_mutation"
              ],
              "properties": {
                "checkpoint": { "const": true },
                "commit": { "const": true },
                "local_merge": { "const": true },
                "named_nonprod_dev_volume_reset": { "const": true },
                "push": { "const": false },
                "deploy": { "const": false },
                "production_mutation": { "const": false }
              }
            },
            "cleanup_policy": { "const": "PRESERVATION_FIRST" }
          }
        }
      }
    },
    "reviewBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "version", "kind", "bundle_id", "plan_id",
        "effective_plan_sha256", "candidate_epoch", "claim_scope",
        "plan_anchors", "diff_artifacts", "evidence_refs", "open_findings",
        "omitted_manifest", "policy"
      ],
      "properties": {
        "schema": { "const": "artifact/execution-contract" },
        "version": { "const": 1 },
        "kind": { "const": "review-bundle" },
        "bundle_id": { "type": "string", "minLength": 1 },
        "plan_id": { "type": "string", "minLength": 1 },
        "effective_plan_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_epoch": { "$ref": "#/$defs/sha256" },
        "claim_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "plan_anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "diff_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifactRef" }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifactRef" }
        },
        "open_findings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "omitted_manifest": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "count", "pointer"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "count": { "type": "integer", "minimum": 0 },
              "pointer": { "$ref": "#/$defs/artifactRef" }
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantic_budget", "raw_logs_default", "full_ledger_default",
            "full_plan_default", "targeted_drilldown", "reviewer_read_only"
          ],
          "properties": {
            "semantic_budget": { "const": "CLAIM_RELEVANT_ONLY" },
            "raw_logs_default": { "const": false },
            "full_ledger_default": { "const": false },
            "full_plan_default": { "const": false },
            "targeted_drilldown": { "const": true },
            "reviewer_read_only": { "const": true }
          }
        }
      }
    }
  }
}
