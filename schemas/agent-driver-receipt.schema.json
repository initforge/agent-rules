{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/agent-driver-receipt.schema.json",
  "title": "Host-neutral AgentDriver receipt",
  "description": "Host execution evidence bound to a task identity; it does not author PASS.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "host", "exit_code", "timed_out", "termination", "cleanup_confirmed", "stdout_sha256", "stderr_sha256"],
  "properties": {
    "schema": { "const": "harness/agent-driver-receipt/v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "execution_generation": { "type": "integer", "minimum": 0 },
    "spec_revision": { "type": "integer", "minimum": 1 },
    "host": { "type": "string", "minLength": 1 },
    "exit_code": { "type": "integer" },
    "timed_out": { "type": "boolean" },
    "termination": { "enum": ["natural", "graceful-stop", "forced-stop"] },
    "cleanup_confirmed": { "type": "boolean" },
    "stdout_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stderr_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
