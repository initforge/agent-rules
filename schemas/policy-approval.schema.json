{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/policy-approval.schema.json",
  "title": "Portable Policy and Approval Contract",
  "description": "A policy and approval contract that defines risk levels per operation category and the autonomy level for agent execution. Platform-neutral; governs what operations are allowed at each risk level and the degree of autonomous vs human-in-the-loop decision-making.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "risk_levels", "autonomy_level"
  ],
  "properties": {
    "schema": { "const": "artifact/policy-approval" },
    "version": { "const": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "risk_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read", "edit", "package_installation", "external_network",
        "migrations", "secrets", "commit", "push", "merge",
        "deployment", "destructive_operations"
      ],
      "properties": {
        "read": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical", "blocked"]
        },
        "edit": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical", "blocked"]
        },
        "package_installation": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical", "blocked"]
        },
        "external_network": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical", "blocked"]
        },
        "migrations": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical", "blocked"]
        },
        "secrets": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical", "blocked"]
        },
        "commit": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical", "blocked"]
        },
        "push": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical", "blocked"]
        },
        "merge": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical", "blocked"]
        },
        "deployment": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical", "blocked"]
        },
        "destructive_operations": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical", "blocked"]
        }
      }
    },
    "autonomy_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "0 = fully manual (human does all work), 1 = human-in-the-loop (agent suggests, human approves each action), 2 = approval gate (agent executes, human approves before risky actions), 3 = supervised (agent runs, human reviews after), 4 = semi-autonomous (human sets constraints, agent operates within them), 5 = fully autonomous (agent operates without human intervention)"
    }
  }
}
