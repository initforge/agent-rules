{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/capability.schema.json",
  "title": "Portable Capability Declaration",
  "description": "A model/tool capability class with runtime mode, isolation, and permission model. Platform-neutral; supports native/emulated/unsupported/unverified states for every dimension.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "class", "mode", "allowed_tool_classes",
    "isolation", "permission_model"
  ],
  "properties": {
    "schema": { "const": "artifact/capability" },
    "version": { "const": 1 },
    "class": {
      "type": "string",
      "enum": ["utility", "economy", "standard", "expert", "unassigned"]
    },
    "mode": {
      "type": "string",
      "enum": ["native", "emulated", "unsupported", "unverified"]
    },
    "allowed_tool_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["read", "edit", "test", "shell", "browser", "network", "git", "external-write"]
      }
    },
    "isolation": {
      "type": "string",
      "enum": ["workspace", "sandbox", "none", "unverified"]
    },
    "permission_model": {
      "type": "string",
      "enum": ["host-enforced", "advisory-delegated", "none", "unverified"]
    },
    "subagent_support": {
      "type": "string",
      "enum": ["native", "emulated", "unsupported", "unverified"]
    },
    "model_attestation": {
      "type": "string",
      "enum": ["native", "emulated", "unsupported", "unverified"]
    },
    "max_delegation_depth": {
      "type": "integer",
      "minimum": 0
    },
    "max_active_agents": {
      "type": "integer",
      "minimum": 0
    },
    "supported_efforts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["low", "medium", "high"]
      }
    },
    "context_delivery": {
      "type": "string",
      "enum": ["file-based", "inline", "api", "unverified"]
    },
    "notes": { "type": "string" }
  }
}
