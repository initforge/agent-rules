{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/claim-evidence-envelope.schema.json",
  "title": "Plan Claim-Evidence Envelope",
  "description": "Canonical schema for per-stage plan evidence envelopes (schema id harness/claim-evidence as written at .agent/evidence/<plan>/<stage>/evidence.json). Each claim entry declares what was executed and the evidence stage it actually reached (AM-0005). An evidence stage is set only by executed observation; command labels and prose cannot mint one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "plan_id", "task_id", "candidate_epoch",
    "observed_at", "head_commit", "claims"
  ],
  "properties": {
    "schema": { "const": "harness/claim-evidence" },
    "version": { "const": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "candidate_epoch": { "type": "integer", "minimum": 0 },
    "observed_at": { "type": "string", "format": "date-time" },
    "head_commit": { "type": "string", "minLength": 7 },
    "required_evidence_stage": {
      "description": "Eval fixture metadata: minimum stage the claims must reach for acceptance.",
      "type": "string",
      "enum": [
        "SOURCE_VERIFIED", "TEST_VERIFIED", "NATIVE_SMOKE_VERIFIED",
        "LIVE_CANDIDATE", "LIVE_OBSERVED", "OPERATIONALLY_PROVEN", "LIVE_UNPROVEN"
      ]
    },
    "expected_outcome": {
      "description": "Eval fixture metadata: expected acceptance outcome.",
      "type": "string",
      "enum": ["PASS", "PARTIAL", "BLOCKED", "SCHEMA_REJECTED"]
    },
    "note": { "type": "string" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "verifier_id", "command", "status"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "verifier_id": { "type": "string", "minLength": 1 },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "status": { "enum": ["pass", "fail", "blocked"] },
          "summary": { "type": "string" },
          "freshness": { "enum": ["fresh", "stale", "unknown"] },
          "evidence_stage": {
            "type": "string",
            "enum": [
              "SOURCE_VERIFIED", "TEST_VERIFIED", "NATIVE_SMOKE_VERIFIED",
              "LIVE_CANDIDATE", "LIVE_OBSERVED", "OPERATIONALLY_PROVEN", "LIVE_UNPROVEN"
            ]
          },
          "artifact_path": { "type": "string", "minLength": 1 },
          "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
          "host": { "type": "string", "minLength": 1 },
          "run_id": { "type": "string", "minLength": 1 },
          "session_id": { "type": "string", "minLength": 1 },
          "candidate_epoch": { "type": "integer", "minimum": 0 },
          "observed_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
