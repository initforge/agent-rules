{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/decision-fabric.schema.json",
  "title": "Typed Decision Fabric receipt",
  "description": "Shadow/active routing decision with typed facts and measurable legacy comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "phase", "skills", "policies", "capabilities", "verifiers", "reviewers", "task_facts", "rationale", "fact_revision"],
  "properties": {
    "schema": { "const": "harness/decision-fabric/v1" },
    "mode": { "enum": ["shadow", "active"] },
    "phase": { "$ref": "task-facts.schema.json#/properties/phase" },
    "skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "policies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "verifiers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "reviewers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "task_facts": { "$ref": "task-facts.schema.json" },
    "rationale": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "fact_revision": { "type": ["string", "null"] },
    "legacy": {
      "type": "object", "additionalProperties": false, "required": ["skills", "capabilities"],
      "properties": {
        "skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "differences": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
