{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/profile-manifest.schema.json",
  "title": "Portable Profile Manifest",
  "description": "An identity/version/source manifest for a deployed artifact (context, skill, integration, overlay, policy). Platform-neutral; enables provenance tracking across builds and runtime mirrors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "name", "artifact_version", "source",
    "sha256", "built_at", "owner"
  ],
  "properties": {
    "schema": { "const": "artifact/profile-manifest" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "artifact_version": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "branch": { "type": "string" },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "built_at": { "type": "string", "format": "date-time" },
    "owner": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "version": { "type": "string" }
        }
      }
    },
    "signing": {
      "type": "object",
      "properties": {
        "method": { "type": "string" },
        "key_fingerprint": { "type": "string" },
        "signature": { "type": "string" }
      }
    }
  }
}
