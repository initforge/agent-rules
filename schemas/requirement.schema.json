{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/requirement.schema.json",
  "title": "Portable Requirement",
  "description": "A source requirement captured from the user, an injection, or a discovery during work. Platform-neutral; each requirement traces to affected slices.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "id", "kind", "summary", "captured_at"
  ],
  "properties": {
    "schema": { "const": "artifact/requirement" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z]+-[0-9]{3}$" },
    "kind": {
      "type": "string",
      "enum": ["original", "injection", "discovery", "external"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "body": { "type": "string" },
    "captured_at": { "type": "string", "format": "date-time" },
    "source_ref": { "type": "string" },
    "redacted": { "type": "boolean" },
    "slice_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
