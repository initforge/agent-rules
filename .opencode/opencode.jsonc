{
  "$schema": "https://opencode.ai/config.json",

  // Main gọi subagents; subagents không được tự tạo tầng agent mới.
  "subagent_depth": 1,
  "default_agent": "harness-orchestrator",

  "agent": {
    "harness-orchestrator": {
      "description": "Owns the complete agent-rules audit, planning, delegation, integration, implementation governance, and final user-facing result.",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "max",
      "thinking": {
        "type": "enabled"
      },
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch*": "allow",
          "git switch*": "allow",
          "git checkout*": "allow",
          "git add*": "allow",
          "git commit*": "ask",
          "git push*": "deny",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "npm *": "allow",
          "npx *": "allow",
          "pnpm *": "allow",
          "node *": "allow",
          "pwsh *": "allow",
          "python *": "allow",
          "pytest *": "allow"
        },
        "task": {
          "*": "deny",
          "harness-auditor": "allow",
          "harness-worker": "allow",
          "harness-verifier": "allow",
          "harness-final-reviewer": "allow"
        },
        "question": "allow",
        "websearch": "allow",
        "webfetch": "allow"
      }
    },

    "harness-auditor": {
      "description": "Read-only senior auditor for repository architecture, git history, CI, automation, evaluations, profiles, platforms, integrations, rules, skills, security and documentation drift. Returns evidence, not edits.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high",
      "thinking": {
        "type": "enabled"
      },
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny",
        "question": "deny",
        "websearch": "allow",
        "webfetch": "allow"
      }
    },

    "harness-worker": {
      "description": "Implements one bounded work slice only. Must respect assigned file ownership, acceptance criteria and existing user changes. Returns changed files, commands and evidence.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "reasoningEffort": "high",
      "thinking": {
        "type": "enabled"
      },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "deny",
        "question": "deny",
        "websearch": "deny",
        "webfetch": "allow"
      }
    },

    "harness-verifier": {
      "description": "Independent read-only verification agent. Runs relevant tests, linters, validators, builds, doctors and diff inspections. It must reject unsupported PASS claims.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "reasoningEffort": "high",
      "thinking": {
        "type": "enabled"
      },
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny",
        "question": "deny"
      }
    },

    "harness-final-reviewer": {
      "description": "Adversarial senior reviewer for the complete integrated diff. Finds missing requirements, architectural drift, regressions, false claims, incomplete migrations and weak verification. Never edits files.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "max",
      "thinking": {
        "type": "enabled"
      },
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny",
        "question": "deny",
        "websearch": "allow",
        "webfetch": "allow"
      }
    }
  }
}
