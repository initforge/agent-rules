# OBSOLETE — replaced by quality.yml + certification.yml
name: static
on:
  pull_request:
  push:
    branches: [main]
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}
permissions:
  contents: read
jobs:
  verify:
    name: verify (${{ matrix.os }})
    strategy:
      matrix:
        os: [ubuntu-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
      - uses: actions/setup-node@1d0ff469b7ec7b3cb9d5e8c9c4b0b3f8c0e0e0e0
        with:
          node-version: "22"
      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b
        with:
          python-version: "3.11"
      - name: Install PowerShell on Linux
        if: runner.os == 'Linux'
        shell: bash
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq powershell
      - run: npm ci
      - run: npm run verify:all
      - run: pwsh -File automation/01-build-runtime.ps1
      - run: pwsh -File automation/03-validate-context.ps1
      - run: pwsh -File automation/04-verify-mirrors.ps1
      - name: Validate documentation drift
        run: |
          python automation/generate-doc-references.py
          python automation/validate-doc-drift.py
      - uses: actions/upload-artifact@65c4c4a1d7e8d8c5e0e1f2a3b4c5d6e7f8a9b0c1
        if: always()
        with:
          name: validate-log-${{ matrix.os }}
          path: packages/cli/validate.log
