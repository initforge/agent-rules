{
  "name": "agent-rules",
  "version": "2.0.0",
  "private": true,
  "description": "Agent Rules harness — cross-platform context management for AI coding assistants",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/cli",
    "packages/engine",
    "packages/kernel"
  ],
  "scripts": {
    "build": "npm run build -w packages/kernel && npm run build -w packages/engine && npm run build -w packages/cli && node packages/cli/dist/index.js build",
    "test": "node automation/run-governed-vitest.mjs --project-root . --cwd . --mode full --timeout-ms 600000 -- run --config vitest.config.ts && npm run test --workspaces --if-present",
    "test:fast": "node automation/run-governed-vitest.mjs --project-root . --cwd . --mode full -- run --config vitest.config.ts --testNamePattern=\"^(?!.*\\\\[(e2e|browser)\\\\]).*$\"",
    "test:e2e": "node automation/run-governed-vitest.mjs --project-root . --cwd . --mode full -- run --config vitest.config.ts --testNamePattern=\\\"\\\\[e2e\\\\]\\\"",
    "test:browser": "node automation/run-governed-vitest.mjs --project-root . --cwd . --mode full -- run --config vitest.config.ts --testNamePattern=\\\"\\\\[browser\\\\]\\\"",
    "check": "npm run typecheck --workspaces --if-present",
    "check:agent-dir": "node automation/validate-agent-dir.mjs",
    "ci:quality": "npm run build && npm run check && npm run test",
    "ci:certify": "bash automation/ci-certify.sh",
    "verify:all": "node automation/verify-all.mjs",
    "verify:all:pwsh": "node automation/run-pwsh.mjs automation/verify-all.ps1",
    "verify:ci": "node automation/verify-all.mjs",
    "verify:windows-hosts": "node automation/verify-windows-hosts.mjs"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.18.10"
  }
}
