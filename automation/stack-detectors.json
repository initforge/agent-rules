{
  "$schema": "../schemas/repo-facts.schema.json",
  "version": 1,
  "description": "Declarative detector inventory for host-independent RepoFacts. Detector code must preserve source hashes and must not infer business requirements.",
  "detectors": [
    { "id": "package-manifest", "facts": ["runtime.node", "package.manager", "framework", "test.runner", "workspace.package"], "inputs": ["package.json", "package-lock.json", "pnpm-lock.yaml", "yarn.lock", "bun.lockb", "*/package.json"] },
    { "id": "mobile-manifest", "facts": ["platform.mobile", "framework.mobile"], "inputs": ["package.json", "app.json", "app.config.js", "app.config.ts"] },
    { "id": "language-files", "facts": ["language"] , "inputs": ["*.ts", "*.tsx", "*.js", "*.jsx", "*.py", "*.go", "*.rs", "*.java", "*.kt", "*.rb", "*.php"] },
    { "id": "terraform", "facts": ["infra.terraform"], "inputs": ["*.tf", "*.tfvars"] },
    { "id": "container", "facts": ["infra.container"], "inputs": ["Dockerfile", "docker-compose.yml", "docker-compose.yaml"] },
    { "id": "database-schema", "facts": ["database.schema", "database.tool"], "inputs": ["prisma/schema.prisma", "drizzle.config.ts", "supabase/config.toml", "migrations/"] },
    { "id": "ci-config", "facts": ["ci.provider"], "inputs": [".github/workflows/", ".gitlab-ci.yml", "azure-pipelines.yml", ".circleci/config.yml"] }
  ]
}
