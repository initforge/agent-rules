{
  "version": 4,
  "description": "CI regression fixtures for progressive-context routing; the compiled context graph is the runtime source, and this file is not a second router or trigger source. 5fedu activation is a fail-closed workspace fact: only .agent/profiles/5fedu.enabled or a validated installed README/rules/behavior/module-mapping lean pack is active. Prompt text, empty/junk context directories, and legacy 00-context-map.md alone are not activation evidence.",
  "budgets": {
    "core_routing_tokens": 4500,
    "normal_execution_tokens": 1550,
    "uncertain_execution_tokens": 2700,
    "plan_authoring_tokens": 4200,
    "harness_edit_tokens": 2800,
    "5fedu_ui_base_tokens": 8000
  },
  "routes": {
    "normal_execution": ["skills/finish-to-completion/SKILL.md"],
    "uncertain_execution": ["skills/finish-to-completion/SKILL.md", "skills/implementation-discovery/SKILL.md"],
    "plan_authoring": ["skills/plan-and-handoff/SKILL.md", "skills/plan-and-handoff/references/plan-artifact-template.md"],
    "harness_edit": ["skills/context-evolution-protocol/SKILL.md"],
    "5fedu_ui_base": ["profiles/5fedu/README.md", "skills/5fedu-project/SKILL.md", "skills/5fedu-module-parity/SKILL.md", "skills/5fedu-module-parity/references/index.md", "profiles/5fedu/module-mapping/modules.yaml", "profiles/5fedu/module-mapping/ui-contracts.md"]
  },
