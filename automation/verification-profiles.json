{
  "schema_version": 1,
  "description": "Domain verification profiles that select checks from claims, changed surfaces, and risk. Each profile lists available checks; the selection algorithm chooses which to run based on context.",
  "profile_contract": {
    "applicability": "Boundary covered by this profile.",
    "risk_triggers": "Signals that promote an otherwise optional check to required.",
    "cost_class": "Relative cost: low, medium, or high.",
    "fidelity": "Evidence fidelity: static, process, runtime, native, or visible-runtime.",
    "replayable": "Whether a deterministic replay recipe may be emitted.",
    "visible_manual": "Manual visibility contract; headless CI is a separate automated mode.",
    "required_dimensions": "Evidence dimensions required for the profile claims.",
    "negative_fixtures": "Named failure or forbidden-behavior fixtures.",
    "owner": "Maintainer of the profile contract.",
    "freshness_binding": "Identity fields that make evidence stale when changed.",
    "invalidation_conditions": "Changes that invalidate an accepted result.",
    "human_residuals": "Semantic questions intentionally left for final human review."
  },
  "domain_profiles": {
    "frontend": {
      "description": "UI components, pages, styles, interactions, and browser behavior",
      "verification_contract": {
        "applicability": ["UI source, layout, interaction, visual, accessibility, and browser-runtime claims"],
        "risk_triggers": ["responsive", "mobile", "parity", "auth boundary", "destructive interaction"],
        "cost_class": "medium",
        "fidelity": "visible-runtime",
        "replayable": true,
        "visible_manual": {"required_when": ["manual", "exploratory"], "providers": ["playwright", "chrome-devtools"], "headless_ci_profile": "frontend-ci", "unavailable_status": "BLOCKED"},
        "required_dimensions": ["interaction", "state", "regression"],
        "negative_fixtures": ["console error", "network failure", "keyboard-only interaction", "viewport overflow", "missing loading/error state"],
        "owner": "project-owner",
        "freshness_binding": ["source_hash", "claim_ids", "browser_version", "fixture_hash", "verifier_identity"],
        "invalidation_conditions": ["changed UI state model", "changed route/API contract", "changed baseline or fixture", "browser/runtime version drift"],
        "human_residuals": ["visual/product intent", "copy and information hierarchy", "acceptable responsive trade-offs"]
      },
      "signals": {
        "file_patterns": ["**/*.tsx", "**/*.jsx", "**/*.vue", "**/*.svelte", "**/*.css", "**/*.scss", "**/*.less", "**/*.html", "**/*.stories.*", "**/*.spec.tsx", "**/*.test.tsx"],
        "claim_keywords": ["ui", "frontend", "component", "page", "layout", "style", "responsive", "viewport", "visual", "parity", "shell", "drawer", "toolbar", "listview"],
        "domains": ["frontend", "ui", "web"]
      },
      "checks": [
        {
          "id": "typecheck",
          "name": "TypeScript type check",
          "proof_kind": "build",
          "evidence_profile": "static-change",
          "required_dimensions": ["outcome", "regression"],
          "tools": ["tsc", "tsc --noEmit", "vue-tsc"],
          "missing_tool_action": "blocked",
          "command_template": "{tool} --noEmit",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.ts", "**/*.tsx", "**/*.vue", "**/*.js", "**/*.jsx"]
        },
        {
          "id": "lint",
          "name": "Lint static analysis",
          "proof_kind": "build",
          "evidence_profile": "static-change",
          "required_dimensions": ["outcome"],
          "tools": ["eslint", "oxlint", "biome lint", "ruff"],
          "missing_tool_action": "skip",
          "command_template": "{tool} .",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.ts", "**/*.tsx", "**/*.vue", "**/*.js", "**/*.jsx", "**/*.css", "**/*.scss"]
        },
        {
          "id": "unit-test",
          "name": "Unit and component tests",
          "proof_kind": "unit",
          "evidence_profile": "implementation-runtime",
          "required_dimensions": ["outcome", "integration", "regression"],
          "tools": ["jest", "vitest", "uvu", "ava", "mocha"],
          "missing_tool_action": "blocked",
          "command_template": "{tool} run",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.{spec,test}.{ts,tsx,js,jsx,vue}", "**/*.stories.*"]
        },
        {
          "id": "browser-interaction",
          "name": "Browser interaction and state verification",
          "proof_kind": "browser",
          "evidence_profile": "ui-runtime",
          "required_dimensions": ["interaction", "state", "regression"],
          "tools": ["playwright", "cypress", "puppeteer"],
          "missing_tool_action": "blocked",
          "command_template": "{tool} test",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.tsx", "**/*.vue", "**/*.spec.tsx", "**/*.e2e.*"]
        },
        {
          "id": "responsive-states",
          "name": "Responsive viewport verification",
          "proof_kind": "browser",
          "evidence_profile": "ui-runtime",
          "required_dimensions": ["interaction", "state", "regression"],
          "conditional_dimensions": {"viewport": ["responsive", "mobile", "viewport"]},
          "tools": ["playwright"],
          "missing_tool_action": "skip",
          "command_template": "{tool} test --grep responsive",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.css", "**/*.scss", "**/*.tsx", "**/*.vue"]
        },
        {
          "id": "visual-comparison",
          "name": "Visual regression comparison",
          "proof_kind": "browser",
          "evidence_profile": "ui-parity",
          "required_dimensions": ["visual", "reference"],
          "tools": ["playwright", "chromatic", "percy", "loki"],
          "missing_tool_action": "skip",
          "command_template": "{tool} visual",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.css", "**/*.scss", "**/*.tsx"]
        },
        {
          "id": "accessibility",
          "name": "Accessibility audit",
          "proof_kind": "browser",
          "evidence_profile": "behavior-safety",
          "required_dimensions": ["outcome", "scope", "negative-constraint"],
          "tools": ["axe", "pa11y", "playwright"],
          "missing_tool_action": "skip",
          "command_template": "npx axe",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.tsx", "**/*.vue", "**/*.html", "**/*.css"]
        },
        {
          "id": "console-network",
          "name": "Browser console and network error check",
          "proof_kind": "browser",
          "evidence_profile": "ui-runtime",
          "required_dimensions": ["interaction", "state"],
          "tools": ["chrome-devtools"],
          "missing_tool_action": "blocked",
          "command_template": "",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.tsx", "**/*.vue", "**/*.js"]
        }
      ]
    },
    "backend-api": {
      "description": "Server-side APIs, services, business logic, and endpoint behavior",
      "verification_contract": {
        "applicability": ["HTTP, RPC, service, validation, authorization, retry, and integration-boundary claims"],
        "risk_triggers": ["auth", "permission", "tenant isolation", "money", "migration", "idempotency", "external side effect"],
        "cost_class": "medium",
        "fidelity": "runtime",
        "replayable": true,
        "visible_manual": {"required_when": [], "providers": [], "headless_ci_profile": "backend-ci", "unavailable_status": "BLOCKED"},
        "required_dimensions": ["positive", "invalid-error", "regression"],
        "negative_fixtures": ["invalid input", "unauthorized access", "cross-tenant read", "timeout/retry", "duplicate request"],
        "owner": "project-owner",
        "freshness_binding": ["source_hash", "claim_ids", "contract_hash", "fixture_hash", "verifier_identity"],
        "invalidation_conditions": ["endpoint/schema change", "auth policy change", "dependency upgrade", "fixture or seed change"],
        "human_residuals": ["business meaning of edge-case errors", "external integration ownership", "acceptable backward compatibility"]
      },
      "signals": {
        "file_patterns": ["**/*.controller.*", "**/*.service.*", "**/*.handler.*", "**/*.route.*", "**/*.middleware.*", "**/*.dto.*", "**/*.validat*.*", "**/api/**", "**/routes/**", "**/controllers/**", "**/*.graphql*", "**/*.proto"],
        "claim_keywords": ["api", "endpoint", "backend", "service", "dto", "contract", "integration", "http", "rest", "grpc", "graphql"],
        "domains": ["backend", "api", "server", "service"]
      },
      "checks": [
        {
          "id": "unit-test",
          "name": "Unit tests for backend logic",
          "proof_kind": "unit",
          "evidence_profile": "implementation-runtime",
          "required_dimensions": ["outcome", "integration", "regression"],
          "tools": ["jest", "vitest", "pytest", "rspec", "junit"],
          "missing_tool_action": "blocked",
          "command_template": "{tool} run",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.spec.*", "**/*.test.*", "**/*.controller.*", "**/*.service.*"]
        },
        {
          "id": "integration-test",
          "name": "Integration tests across service boundaries",
          "proof_kind": "integration",
          "evidence_profile": "api-contract",
          "required_dimensions": ["positive", "invalid-error", "regression"],
          "tools": ["supertest", "pytest", "newman", "httparty"],
          "missing_tool_action": "blocked",
          "command_template": "{tool} integration",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/integration/**", "**/*.int.spec.*", "**/api/**"]
        },
        {
          "id": "contract-test",
          "name": "Contract and pact verification",
          "proof_kind": "api",
          "evidence_profile": "api-contract",
          "required_dimensions": ["positive", "invalid-error", "regression"],
          "tools": ["pact", "@pact-foundation/pact", "pact-js"],
          "missing_tool_action": "skip",
          "command_template": "{tool} verify",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/contracts/**", "**/*.pact.*", "**/*.proto"]
        },
        {
          "id": "authorization-matrix",
          "name": "Authorization matrix verification",
          "proof_kind": "security",
          "evidence_profile": "access-control",
          "required_dimensions": ["allowed", "denied", "isolation"],
          "tools": ["supertest", "pytest", "newman"],
          "missing_tool_action": "skip",
          "command_template": "{tool} auth --matrix",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.controller.*", "**/*.middleware.*", "**/auth*/*", "**/permission*/*"]
        },
        {
          "id": "validation-test",
          "name": "Input validation and error handling",
          "proof_kind": "integration",
          "evidence_profile": "api-contract",
          "required_dimensions": ["positive", "invalid-error"],
          "tools": ["supertest", "pytest", "newman"],
          "missing_tool_action": "skip",
          "command_template": "{tool} validation",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.validat*.*", "**/*.dto.*", "**/*.schema.*"]
        },
        {
          "id": "failure-retry-idempotency",
          "name": "Failure, retry, and idempotency verification",
          "proof_kind": "integration",
          "evidence_profile": "concurrency-idempotency",
          "required_dimensions": ["contention", "retry-failure", "idempotency"],
          "tools": ["pytest", "jest"],
          "missing_tool_action": "skip",
          "command_template": "{tool} retry",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.retry*", "**/*.idempot*", "**/*.queue*", "**/*.worker*"]
        },
        {
          "id": "timeout-test",
          "name": "Timeout and deadline propagation",
          "proof_kind": "integration",
          "evidence_profile": "implementation-runtime",
          "required_dimensions": ["outcome", "integration"],
          "tools": ["pytest", "jest"],
          "missing_tool_action": "skip",
          "command_template": "{tool} timeout",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.timeout*", "**/*.deadline*", "**/client*.*", "**/*.http*"]
        },
        {
          "id": "observability",
          "name": "Observability instrumentation check",
          "proof_kind": "static",
          "evidence_profile": "implementation-runtime",
          "required_dimensions": ["outcome", "regression"],
          "tools": [],
          "missing_tool_action": "skip",
          "command_template": "",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.ts", "**/*.py", "**/*.go", "**/*.java", "**/*.rb"]
        }
      ]
    },
    "database": {
      "description": "Schema changes, migrations, queries, and data integrity",
      "verification_contract": {
        "applicability": ["Schema, migration, query, index, seed, and persistence-integrity claims"],
        "risk_triggers": ["migration", "destructive", "existing data", "high volume", "tenant isolation", "rollback"],
        "cost_class": "high",
        "fidelity": "runtime",
        "replayable": true,
        "visible_manual": {"required_when": [], "providers": [], "headless_ci_profile": "database-ci", "unavailable_status": "BLOCKED"},
        "required_dimensions": ["blank", "existing-clone", "reconciliation", "failure-path"],
        "negative_fixtures": ["existing-data migration", "rollback/failure", "duplicate/constraint violation", "query-plan regression", "stale cache/read"],
        "owner": "project-owner",
        "freshness_binding": ["source_hash", "migration_hash", "schema_hash", "fixture_hash", "database_engine_version"],
        "invalidation_conditions": ["migration order change", "schema or index change", "engine/version drift", "seed or fixture change"],
        "human_residuals": ["business data retention", "acceptable downtime", "rollback authority and production sequencing"]
      },
      "signals": {
        "file_patterns": ["**/migrations/**", "**/*.migration.*", "**/*.sql", "**/*.prisma", "**/schema.*", "**/*.entity.*", "**/*.model.*", "**/*.repository.*", "**/*.dao.*", "**/seed*"],
        "claim_keywords": ["migration", "schema", "database", "query", "data", "entity", "model", "repository", "index", "constraint"],
        "domains": ["database", "data", "migration", "persistence"]
      },
      "checks": [
        {
          "id": "schema-diff",
          "name": "Schema diff comparison",
          "proof_kind": "diff",
          "evidence_profile": "migration-reconciliation",
