          "tools": ["prisma", "typeorm", "sequelize", "alembic", "diesel"],
          "missing_tool_action": "skip",
          "command_template": "{tool} migrate:up",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/migrations/**"]
        },
        {
          "id": "constraints",
          "name": "Constraint and index verification",
          "proof_kind": "integration",
          "evidence_profile": "migration-reconciliation",
          "required_dimensions": ["reconciliation", "failure-path"],
          "tools": ["prisma", "typeorm", "sequelize", "alembic"],
          "missing_tool_action": "skip",
          "command_template": "{tool} constraint:check",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/*.entity.*", "**/schema*", "**/migrations/**"]
        },
        {
          "id": "backfill",
          "name": "Backfill verification",
          "proof_kind": "integration",
          "evidence_profile": "migration-reconciliation",
          "required_dimensions": ["reconciliation", "failure-path"],
          "tools": [],
          "missing_tool_action": "skip",
          "command_template": "",
          "expected_exit_code": 0,
          "mandatory": false,
          "affected_by": ["**/migrations/**"]
        },
        {
          "id": "rollback",
          "name": "Migration rollback",
          "proof_kind": "integration",
