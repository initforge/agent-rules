# Supabase (required for dev with real DB; required on Vercel)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase CLI — deploy edge functions (local only, never commit real token)
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=

# Cloudinary — unsigned upload preset only (never put API secret in Vite client)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Dev overrides (production defaults: Supabase + Cloudinary — no need to set on Vercel)
# VITE_DATA_SOURCE=mock
# VITE_MEDIA_PROVIDER=local

# Optional
# VITE_SENTRY_DSN=
# VITE_USE_PERMISSION_MATRIX=false
# VITE_AUTH_EMAIL_SUFFIX=@gmail.com
