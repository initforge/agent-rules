{
  "name": "@initforge/agent-rules-mcp-guardian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent MCP session broker + guardian + host adapters for agent-rules (OpenCode, DeepSeek Harness, Codex). Exclusive leases by default; X11 EWMH placement; reconnect/recreate; registry-driven projection.",
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "node ../../automation/run-governed-vitest.mjs --project-root ../.. --cwd . --mode focused -- run",
    "test:live": "MCP_LIVE=1 node ../../node_modules/vitest/vitest.mjs run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.10",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
