{
  "name": "@initforge/agent-rules-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical contracts and execution engine for Agent Rules",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc",
    "typecheck": "tsc --noEmit",
    "test": "node ../../automation/run-governed-vitest.mjs --project-root ../.. --cwd . --mode full -- run",
    "test:jest": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.ts",
    "test:jest:watch": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.ts --watch"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "jest": "^29.7.0",
    "playwright": "^1.62.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  }
}
