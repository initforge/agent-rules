{
  "name": "@initforge/agent-rules-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical contracts and execution engine for Agent Rules",
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./parity-contracts": {
      "types": "./dist/parity-contracts.d.ts",
      "import": "./dist/parity-contracts.js"
    },
    "./plan-lifecycle": {
      "types": "./dist/plan-lifecycle.d.ts",
      "import": "./dist/plan-lifecycle.js"
    },
    "./terminal-gate": {
      "types": "./dist/terminal-gate.d.ts",
      "import": "./dist/terminal-gate.js"
    },
    "./evidence-packet": {
      "types": "./dist/evidence-packet.d.ts",
      "import": "./dist/evidence-packet.js"
    },
    "./activation-transaction": {
      "types": "./dist/activation-transaction.d.ts",
      "import": "./dist/activation-transaction.js"
    },
    "./secure-fs": {
      "types": "./dist/secure-fs.d.ts",
      "import": "./dist/secure-fs.js"
    },
    "./activation-semantics": {
      "types": "./dist/activation-semantics.d.ts",
      "import": "./dist/activation-semantics.js"
    },
    "./activation-projections": {
      "types": "./dist/activation-projections.d.ts",
      "import": "./dist/activation-projections.js"
    },
    "./ledger-activation": {
      "types": "./dist/ledger-activation.d.ts",
      "import": "./dist/ledger-activation.js"
    },
    "./ledger-migration": {
      "types": "./dist/ledger-migration.d.ts",
      "import": "./dist/ledger-migration.js"
    },
    "./plan-identity": {
      "types": "./dist/plan-identity.d.ts",
      "import": "./dist/plan-identity.js"
    },
    "./autopilot": {
      "types": "./dist/autopilot.d.ts",
      "import": "./dist/autopilot.js"
    },
    "./native-session-adapter": {
      "types": "./dist/native-session-adapter.d.ts",
      "import": "./dist/native-session-adapter.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@types/node": "^22.14.0",
    "playwright": "^1.62.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  }
}
