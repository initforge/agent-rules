{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initforge.github.io/agent-rules/route-capsule.schema.json",
  "title": "Native turn route capsule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "route_id", "generation", "idempotency_key", "protocol_version", "host", "session_id", "turn_id", "status", "model", "skills", "integrations", "context", "proof", "identity", "observed"],
  "properties": {
    "schema": { "const": "agent-rules/route-capsule" },
    "version": { "const": 1 },
    "route_id": { "type": "string", "pattern": "^RT-[0-9a-f]{24}$" },
    "generation": { "type": "integer", "minimum": 0 },
    "idempotency_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "protocol_version": { "type": "string" },
    "host": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["READY", "NEEDS_USER", "BLOCKED", "UNSUPPORTED", "DEGRADED"] },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "observed"],
      "properties": {
        "requested": { "type": ["string", "null"] },
        "observed": { "type": "null" }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "primary", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "primary": { "type": "boolean" },
          "reason": { "type": "string" },
          "source": { "type": "string" },
          "source_hash": { "type": "string" },
          "graph_hash": { "type": "string" }
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "provider"],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "provider": { "type": ["string", "null"] },
          "suppressed_reason": { "type": "string" }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimated_tokens", "rendered"],
      "properties": {
        "estimated_tokens": { "type": "integer", "minimum": 0 },
        "rendered": { "type": "string" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "omitted"],
      "properties": {
        "selected": { "type": "array", "items": { "type": "string" } },
        "omitted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["proof", "reason"],
            "properties": { "proof": { "type": "string" }, "reason": { "type": "string" } }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_sha256", "context_sha256"],
      "properties": {
        "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "context_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routed_at", "router_version"],
      "properties": { "routed_at": { "type": "string" }, "router_version": { "type": "string" } }
    }
  }
}
