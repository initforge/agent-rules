{
  "name": "@initforge/agent-rules",
  "version": "0.1.0",
  "description": "Cross-platform CLI control plane for Agent Rules harness",
  "keywords": [
    "agent-rules",
    "harness",
    "orchestration"
  ],
  "homepage": "https://github.com/initforge/agent-rules",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "bin": {
    "agent-rules": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc && node test/opencode-artifact-smoke.mjs",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "prepack": "npm run build",
    "test": "node ../../automation/run-governed-vitest.mjs --project-root ../.. --cwd . --mode focused -- run",
    "test:watch": "node ../../automation/run-governed-vitest.mjs --project-root ../.. --cwd . --mode focused -- --watch",
    "test:package-smoke": "node test/runtime-package-smoke.mjs"
  },
  "dependencies": {
    "@initforge/agent-rules-engine": "0.1.0",
    "@initforge/agent-rules-kernel": "0.1.0",
    "@opencode-ai/sdk": "^1.18.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  },
  "packageManager": "npm@11.13.0"
}
