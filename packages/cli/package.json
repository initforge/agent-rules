    "test:package-smoke": "node test/runtime-package-smoke.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@initforge/agent-rules-engine": "0.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "packageManager": "npm@11.13.0"
}
