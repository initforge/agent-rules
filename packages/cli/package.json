{
  "name": "@initforge/agent-rules",
  "version": "2.0.0",
  "description": "Cross-platform CLI for the Agent Rules harness",
  "keywords": [
    "agent-rules",
    "harness",
    "native-routing"
  ],
  "homepage": "https://github.com/initforge/agent-rules",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "bin": {
    "agent-rules": "./dist/index.js"
  },
  "files": [
    "dist",
    "runtime-assets"
  ],
  "scripts": {
    "build": "node ../../automation/package-runtime-assets.mjs && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && node ../../node_modules/typescript/bin/tsc",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "prepack": "npm run build",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs --config vitest.config.ts --watch",
    "test:package-smoke": "node test/runtime-package-smoke.mjs"
  },
  "dependencies": {
    "@initforge/agent-rules-kernel": "2.0.0",
    "@opencode-ai/sdk": "^1.18.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  },
  "packageManager": "npm@11.13.0"
}
