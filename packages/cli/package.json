{
  "name": "@initforge/agent-rules",
  "version": "0.1.0",
  "description": "Cross-platform CLI control plane for Agent Rules harness",
  "keywords": [
    "agent-rules",
    "harness",
    "orchestration"
  ],
  "homepage": "https://github.com/initforge/agent-rules",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "bin": {
    "agent-rules": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "prepack": "npm run build",
