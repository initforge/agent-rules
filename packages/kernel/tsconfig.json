{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "src/index.ts",
    "src/contracts.ts",
    "src/northstar/domain-packs.ts",
    "src/northstar/health-contract.ts",
    "src/northstar/host-adapters.ts",
    "src/northstar/host-registry.ts",
    "src/northstar/index.ts",
    "src/northstar/native-turn-router.ts",
    "src/northstar/proof-router.ts",
    "src/northstar/proof-testing.ts",
    "src/northstar/routing.ts",
    "src/northstar/rule-enforcement.ts",
    "src/harness/evidence/proof-policy.ts",
    "src/harness/evidence/proof-router.ts",
    "src/harness/review/materiality.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
