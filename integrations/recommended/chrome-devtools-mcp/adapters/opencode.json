{
  "mcpServers": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/d",
        "/s",
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@1.7.0",
        "--isolated",
        "--executablePath",
        "${OPENCODE_CHROME_PATH}"
      ],
      "enabled": true,
      "environment": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      }
    }
  }
}
